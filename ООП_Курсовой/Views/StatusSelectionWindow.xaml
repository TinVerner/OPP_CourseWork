<Window x:Class="ООП_Курсовой.Views.StatusSelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:tables="clr-namespace:ООП_Курсовой.Tables"
        Title="Выбор статуса"
        Width="400"
        Height="300"
        WindowStartupLocation="CenterOwner"
        Background="#111111"
        ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Выберите новый статус заказа"
                   Foreground="White"
                   FontSize="18"
                   FontWeight="Bold"
                   Margin="0,0,0,20"/>

        <ListBox x:Name="StatusListBox"
                 Grid.Row="1"
                 Background="#000000"
                 BorderBrush="#FF4D00"
                 BorderThickness="1"
                 Foreground="White"
                 Margin="0,0,0,20">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Margin" Value="0,2"/>
                    <Setter Property="Padding" Value="8,4"/>
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="#FF4D00"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#333333"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </ListBox.ItemContainerStyle>
        </ListBox>

        <StackPanel Grid.Row="2" 
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Content="Отмена"
                    Width="100"
                    Height="35"
                    Margin="0,0,10,0"
                    Style="{StaticResource RoundedButton}"
                    Click="CancelButton_Click"/>
            <Button Content="Применить"
                    Width="100"
                    Margin="0,0,10,0"
                    Height="35"
                    Style="{StaticResource RoundedButton}"
                    Click="ApplyButton_Click"/>
        </StackPanel>
    </Grid>
</Window>

