<UserControl x:Class="ООП_Курсовой.Views.Pages.CreateCustomRollPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:support="clr-namespace:ООП_Курсовой.SupportClasses"
             Background="#111111">
    <UserControl.Resources>
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Соберите свой собственный ролл"
                   Foreground="#FF4D00"
                   FontSize="28"
                   FontWeight="Bold"
                   Margin="0,0,0,10"/>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="3*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Margin="0,0,20,0">
                <Border Background="#000000"
                        CornerRadius="16"
                        BorderBrush="#FF4D00"
                        BorderThickness="1"
                        Height="380"
                        HorizontalAlignment="Center">
                    <Image Source="{Binding DisplayImageUrl}"
                           Stretch="Uniform"
                           Margin="16"/>
                </Border>

                <Button Content="Выбрать изображение"
                        Style="{StaticResource RoundedButton}"
                        Height="32"
                        Margin="0,10,0,0"
                        Visibility="{Binding AdminPanelVisibility}"
                        Command="{Binding BrowseImageCommand}"/>

                <TextBlock Text="Название вашего ролла"
                           Foreground="#CCCCCC"
                           FontSize="14"
                           Margin="0,16,0,4"/>
                <TextBox x:Name="RollNameTextBox"
                         Background="#000000"
                         Foreground="White"
                         BorderBrush="#FF4D00"
                         BorderThickness="1"
                         Padding="6"
                         FontSize="16"
                         MaxLength="50"
                         Text="{Binding RollName}"/>

                <TextBlock Text="Выбранные ингредиенты"
                           Foreground="#CCCCCC"
                           FontSize="14"
                           Margin="0,16,0,4"/>
                <Border Background="#000000"
                        CornerRadius="8"
                        BorderBrush="#333333"
                        BorderThickness="1"
                        Padding="8"
                        Height="120">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <TextBlock Text="{Binding SelectedIngredientsText}"
                                   Foreground="#DDDDDD"
                                   TextWrapping="Wrap"/>
                    </ScrollViewer>
                </Border>

                <TextBlock Text="{Binding SelectedCountText}"
                           Margin="0,6,0,0"
                           Foreground="#FF4D00"
                           FontSize="13"/>
            </StackPanel>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Выберите ингредиенты (не более 5)"
                           Foreground="#CCCCCC"
                           FontSize="14"
                           Margin="0,0,0,6"
                           Grid.Row="0"/>

                <Border Background="#000000"
                        CornerRadius="12"
                        BorderBrush="#FF4D00"
                        BorderThickness="1"
                        Grid.Row="1">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding IngredientOptions}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Content="{Binding Name}"
                                              IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                              Foreground="White"
                                              Margin="8,4"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Grid>

        <Grid Grid.Row="2" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Text="{Binding PriceText}"
                       Grid.Column="0"
                       VerticalAlignment="Center"
                       Foreground="#FFFFFF"
                       FontSize="16"
                       FontWeight="Bold"/>

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">

                <Button Content="Сбросить выбор"
                        Style="{StaticResource RoundedButton}"
                        Width="180"
                        Margin="0,0,10,0"
                        Command="{Binding ResetSelectionCommand}"/>

                <Button Content="Создать ролл"
                        Style="{StaticResource RoundedButton}"
                        Width="200"
                        Margin="0,0,10,0"
                        Command="{Binding CreateRollOnlyCommand}"/>

                <Button Content="Создать и добавить в корзину"
                        Style="{StaticResource RoundedButton}"
                        Width="240"
                        Margin="0,0,10,0"
                        Command="{Binding CreateRollAndAddToCartCommand}"/>

            </StackPanel>
        </Grid>
    </Grid>
</UserControl>

