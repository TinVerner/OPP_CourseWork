<UserControl x:Class="ООП_Курсовой.Views.Pages.OrdersPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:support="clr-namespace:ООП_Курсовой.SupportClasses"
             Background="#111111">
    <UserControl.Resources>
        <support:CountToVisibilityConverter x:Key="CountToVisibilityConverter"/>
        <support:CountToVisibilityConverterInverse x:Key="CountToVisibilityConverterInverse"/>
        <support:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </UserControl.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,20">
            <TextBlock Text="📋"
                       Foreground="#FF4D00"
                       FontSize="36"
                       Margin="0,0,15,0"
                       VerticalAlignment="Center"/>
            <TextBlock Text="Мои заказы"
                       Foreground="#FF4D00"
                       FontSize="36"
                       FontWeight="Bold"
                       VerticalAlignment="Center"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid>
                <StackPanel Visibility="{Binding Orders.Count, Converter={StaticResource CountToVisibilityConverter}}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Margin="0,100,0,0">
                    <TextBlock Text="📋"
                               Foreground="#FF4D00"
                               FontSize="80"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,20"/>
                    <TextBlock Text="У вас пока нет заказов"
                               Foreground="White"
                               FontSize="24"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,10"/>
                    <TextBlock Text="Оформите заказ из корзины, чтобы увидеть его здесь"
                               Foreground="#CCCCCC"
                               FontSize="16"
                               HorizontalAlignment="Center"/>
                </StackPanel>
                
                <ItemsControl ItemsSource="{Binding Orders}"
                              Visibility="{Binding Orders.Count, Converter={StaticResource CountToVisibilityConverterInverse}}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#000000"
                                    BorderBrush="#FF4D00"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Margin="0,0,0,15"
                                    Padding="20">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding Id, StringFormat='Заказ №{0}'}"
                                                   Foreground="White"
                                                   FontSize="20"
                                                   FontWeight="Bold"
                                                   Margin="0,0,0,10"/>
                                        <TextBlock Text="{Binding Status, StringFormat='Статус: {0}'}"
                                                   Foreground="#FF4D00"
                                                   FontSize="16"
                                                   FontWeight="Bold"
                                                   Margin="0,0,0,8"/>
                                        <TextBlock Text="{Binding Description}"
                                                   Foreground="#CCCCCC"
                                                   FontSize="14"
                                                   TextWrapping="Wrap"
                                                   Margin="0,0,0,8"
                                                   MaxHeight="60"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding TotalPrice, StringFormat='Цена: {0} руб.'}"
                                                   Foreground="#FF4D00"
                                                   FontSize="18"
                                                   FontWeight="Bold"
                                                   Margin="0,8,0,0"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1"
                                                Orientation="Horizontal"
                                                VerticalAlignment="Center"
                                                Margin="20,0,0,0">
                                        <Button Content="Отменить"
                                                Width="130"
                                                Height="40"
                                                FontSize="16"
                                                Command="{Binding DataContext.CancelOrderCommand, RelativeSource={RelativeSource AncestorType=UserControl, Mode=FindAncestor}}"
                                                CommandParameter="{Binding Id}"
                                                Style="{StaticResource RoundedButton}"
                                                Margin="0,0,10,0"
                                                Visibility="{Binding CanCancel, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                        <Button Content="Подробнее"
                                                Width="150"
                                                Height="40"
                                                Margin="0,0,10,0"
                                                FontSize="16"
                                                Command="{Binding DataContext.ViewDetailsCommand, RelativeSource={RelativeSource AncestorType=UserControl, Mode=FindAncestor}}"
                                                CommandParameter="{Binding Id}"
                                                Style="{StaticResource RoundedButton}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>

