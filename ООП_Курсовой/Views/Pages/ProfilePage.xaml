<UserControl x:Class="ООП_Курсовой.Views.Pages.ProfilePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#111111">
    <Grid Margin="40">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Профиль пользователя"
                   Foreground="#FF4D00"
                   FontSize="32"
                   FontWeight="Bold"
                   Margin="0,0,0,20"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Width="700" MaxWidth="700">
                
                <Border Background="#000000"
                        CornerRadius="12"
                        BorderBrush="#FF4D00"
                        BorderThickness="2"
                        Padding="25"
                        Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="Основная информация"
                                   Foreground="#FF4D00"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Margin="0,0,0,20"/>

                        <TextBlock Text="Логин"
                                   Foreground="#CCCCCC"
                                   FontSize="14"
                                   Margin="0,0,0,5"/>
                        <TextBox Style="{StaticResource RoundedTextBox}"
                                 FontSize="16"
                                 Margin="0,0,0,15"
                                 Text="{Binding Login, UpdateSourceTrigger=PropertyChanged}"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="15"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Имя"
                                           Foreground="#CCCCCC"
                                           FontSize="14"
                                           Margin="0,0,0,5"/>
                                <TextBox Style="{StaticResource RoundedTextBox}"
                                         FontSize="16"
                                         Margin="0,0,0,0"
                                         Text="{Binding FirstName, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Фамилия"
                                           Foreground="#CCCCCC"
                                           FontSize="14"
                                           Margin="0,0,0,5"/>
                                <TextBox Style="{StaticResource RoundedTextBox}"
                                         FontSize="16"
                                         Margin="0,0,0,0"
                                         Text="{Binding LastName, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Background="#000000"
                        CornerRadius="12"
                        BorderBrush="#FF4D00"
                        BorderThickness="2"
                        Padding="25"
                        Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="Контактная информация"
                                   Foreground="#FF4D00"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Margin="0,0,0,20"/>

                        <TextBlock Text="Email"
                                   Foreground="#CCCCCC"
                                   FontSize="14"
                                   Margin="0,0,0,5"/>
                        <TextBox Style="{StaticResource RoundedTextBox}"
                                 Height="35"
                                 FontSize="16"
                                 Margin="0,0,0,15"
                                 Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Text="Телефон"
                                   Foreground="#CCCCCC"
                                   FontSize="14"
                                   Margin="0,0,0,5"/>
                        <TextBox Style="{StaticResource RoundedTextBox}"
                                 FontSize="16"
                                 Margin="0,0,0,15"
                                 Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Text="Адрес"
                                   Foreground="#CCCCCC"
                                   FontSize="14"
                                   Margin="0,0,0,5"/>
                        <TextBox Style="{StaticResource RoundedTextBox}"
                                 Height="80"
                                 FontSize="16"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 Margin="0,0,0,0"
                                 Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                </Border>

                <Border Background="#000000"
                        CornerRadius="12"
                        BorderBrush="#333333"
                        BorderThickness="1"
                        Padding="25"
                        Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="Информация об аккаунте"
                                   Foreground="#CCCCCC"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Margin="0,0,0,15"/>

                        <TextBlock Text="{Binding RoleText}"
                                   Foreground="#FF4D00"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,8"/>

                        <TextBlock Text="{Binding CreatedAtText}"
                                   Foreground="#AAAAAA"
                                   FontSize="14"
                                   Margin="0,0,0,0"/>
                    </StackPanel>
                </Border>

                <Border Background="#000000"
                        CornerRadius="12"
                        BorderBrush="#FF4D00"
                        BorderThickness="2"
                        Padding="25"
                        Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="Смена пароля"
                                   Foreground="#FF4D00"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Margin="0,0,0,20"/>

                        <TextBlock Text="Текущий пароль"
                                   Foreground="#CCCCCC"
                                   FontSize="14"
                                   Margin="0,0,0,5"/>
                        <PasswordBox x:Name="CurrentPasswordBox"
                                     Style="{StaticResource RoundedPasswordBox}"
                                     FontSize="16"
                                     Margin="0,0,0,15"/>

                        <TextBlock Text="Новый пароль"
                                   Foreground="#CCCCCC"
                                   FontSize="14"
                                   Margin="0,0,0,5"/>
                        <PasswordBox x:Name="NewPasswordBox"
                                     Style="{StaticResource RoundedPasswordBox}"
                                     FontSize="16"
                                     Margin="0,0,0,15"/>

                        <TextBlock Text="Повторите новый пароль"
                                   Foreground="#CCCCCC"
                                   FontSize="14"
                                   Margin="0,0,0,5"/>
                        <PasswordBox x:Name="ConfirmPasswordBox"
                                     Style="{StaticResource RoundedPasswordBox}"
                                     FontSize="16"
                                     Margin="0,0,0,0"/>
                    </StackPanel>
                </Border>

                <Button Content="Сохранить"
                        Width="200"
                        Height="50"
                        FontSize="18"
                        FontWeight="SemiBold"
                        HorizontalAlignment="Left"
                        Margin="0,10,0,20"
                        Style="{StaticResource RoundedButton}"
                        Command="{Binding SaveProfileCommand}"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>

