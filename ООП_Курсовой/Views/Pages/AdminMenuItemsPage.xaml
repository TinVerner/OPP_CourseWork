<UserControl x:Class="ООП_Курсовой.Views.Pages.AdminMenuItemsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:support="clr-namespace:ООП_Курсовой.SupportClasses"
             Background="#111111">
    <UserControl.Resources>
        <support:StringToBoolConverter x:Key="StringToBoolConverter"/>
        <support:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="310"/>
        </Grid.ColumnDefinitions>

        <ScrollViewer x:Name="MainScrollViewer"
                      Grid.Column="0" Margin="20"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Background="Transparent">
            <ScrollViewer.RenderTransform>
                <ScaleTransform x:Name="ContentScaleTransform"
                        ScaleX="1" ScaleY="1"/>
            </ScrollViewer.RenderTransform>

            <ItemsControl x:Name="ItemsList" 
                          ItemsSource="{Binding FilteredItems}"
                          Background="Transparent">

                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Width="320"
                                Margin="20"
                                Padding="10"
                                CornerRadius="10"
                                Background="#000000"
                                BorderBrush="#FF4D00"
                                BorderThickness="1">

                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0">
                                    <Image Source="{Binding ImageUrl}"
                                           Height="290"
                                           Stretch="UniformToFill"
                                           Margin="0,0,0,10"/>

                                    <TextBlock Text="{Binding Name}"
                                               Foreground="White"
                                               FontSize="18"
                                               FontWeight="Bold"
                                               TextWrapping="Wrap"/>

                                    <TextBlock Text="{Binding Price, StringFormat='Цена: {0} руб.'}"
                                               Foreground="#FFFFFF"
                                               FontSize="16"
                                               Margin="0,6,0,0"/>

                                    <TextBlock Text="{Binding ItemTypeDisplay, StringFormat='Тип: {0}'}"
                                               Foreground="#CCCCCC"
                                               FontSize="12"
                                               Margin="0,6,0,10"/>

                                    <TextBlock Text="{Binding IngredientsText}"
                                               Foreground="#CCCCCC"
                                               FontSize="12"
                                               Margin="0,0,0,10"
                                               TextWrapping="Wrap"
                                               Visibility="{Binding IngredientsText, Converter={StaticResource StringToVisibilityConverter}}"/>
                                </StackPanel>

                                <StackPanel Grid.Row="1" Margin="0,10,0,0">

                                    <Button Content="Подробнее"
                                            Style="{StaticResource RoundedButton}"
                                            Height="32"
                                            Margin="0,0,0,6"
                                            Command="{Binding DataContext.DetailsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding Id}"/>

                                    <Button Content="Редактировать"
                                            Style="{StaticResource RoundedButton}"
                                            Height="32"
                                            Margin="0,0,0,6"
                                            Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding Id}"/>

                                    <Button Content="Удалить"
                                            Style="{StaticResource RoundedButton}"
                                            Height="32"
                                            Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding Id}"/>
                                </StackPanel>

                            </Grid>
                        </Border>

                    </DataTemplate>
                </ItemsControl.ItemTemplate>

            </ItemsControl>
        </ScrollViewer>

        <Border Grid.Column="1"
        Background="#000000"
        Margin="10,20,20,20"
        CornerRadius="10"
        BorderBrush="#FF4D00"
        BorderThickness="1">
            <StackPanel Margin="10">

                <TextBlock Text="Все позиции меню"
                   Foreground="#FF4D00"
                   FontSize="20"
                   FontWeight="Bold"
                   Margin="0,0,0,6"/>

                <TextBlock Text="Поиск по названию"
                   Foreground="#FF4D00"
                   FontSize="20"
                   FontWeight="Bold"
                   Margin="0,0,0,6"/>

                <TextBox x:Name="SearchTextBox"
                 Margin="0,0,0,10"
                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                 Background="#111111"
                 Foreground="White"
                 BorderBrush="#FF4D00"
                 BorderThickness="1"
                 FontSize="18"
                 Padding="6"/>

                <TextBlock Text="Фильтр по типу"
                   Foreground="#FF4D00"
                   FontSize="20"
                   FontWeight="Bold"
                   Margin="0,0,0,10"/>

                <ScrollViewer Height="140"
                      VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <RadioButton Content="Все типы"
                                     GroupName="ItemTypes"
                                     IsChecked="{Binding SelectedItemType, Converter={StaticResource StringToBoolConverter}, ConverterParameter=all, Mode=TwoWay}"
                                     Foreground="White"
                                     Margin="0,2,0,6"/>

                        <RadioButton Content="Ролл"
                                     GroupName="ItemTypes"
                                     IsChecked="{Binding SelectedItemType, Converter={StaticResource StringToBoolConverter}, ConverterParameter=roll, Mode=TwoWay}"
                                     Foreground="White"
                                     Margin="0,2,0,2"/>

                        <RadioButton Content="Сет"
                                     GroupName="ItemTypes"
                                     IsChecked="{Binding SelectedItemType, Converter={StaticResource StringToBoolConverter}, ConverterParameter=set, Mode=TwoWay}"
                                     Foreground="White"
                                     Margin="0,2,0,2"/>

                        <RadioButton Content="Кастомный ролл"
                                     GroupName="ItemTypes"
                                     IsChecked="{Binding SelectedItemType, Converter={StaticResource StringToBoolConverter}, ConverterParameter=custom_roll, Mode=TwoWay}"
                                     Foreground="White"
                                     Margin="0,2,0,2"/>

                        <RadioButton Content="Кастомный сет"
                                     GroupName="ItemTypes"
                                     IsChecked="{Binding SelectedItemType, Converter={StaticResource StringToBoolConverter}, ConverterParameter=custom_set, Mode=TwoWay}"
                                     Foreground="White"
                                     Margin="0,2,0,2"/>
                    </StackPanel>
                </ScrollViewer>

                <TextBlock Text="Сортировка"
                   Foreground="#FF4D00"
                   FontSize="20"
                   FontWeight="Bold"
                   Margin="0,10,0,4"/>

                <StackPanel Margin="0,0,0,10">

                    <RadioButton Content="Цена по возрастанию"
                         GroupName="SortGroup"
                         IsChecked="{Binding SortMode, Converter={StaticResource StringToBoolConverter}, ConverterParameter='priceAsc', Mode=TwoWay}"
                         Foreground="White"/>

                    <RadioButton Content="Цена по убыванию"
                         GroupName="SortGroup"
                         IsChecked="{Binding SortMode, Converter={StaticResource StringToBoolConverter}, ConverterParameter='priceDesc', Mode=TwoWay}"
                         Foreground="White"/>

                </StackPanel>

                <Button Content="Сбросить фильтры"
                Margin="0,10,0,0"
                FontSize="18"
                Style="{StaticResource RoundedButton}"
                Command="{Binding ResetFiltersCommand}"/>

            </StackPanel>
        </Border>

    </Grid>
</UserControl>

