<UserControl x:Class="ООП_Курсовой.Views.Pages.AdminPanelPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#111111">
    <Grid Background="#111111">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    MaxWidth="800"
                    Margin="40">
            
            <Border Width="120"
                    Height="120"
                    CornerRadius="60"
                    Background="#000000"
                    BorderBrush="#FF4D00"
                    BorderThickness="3"
                    HorizontalAlignment="Center"
                    Margin="0,0,0,30">
                <TextBlock Text="⚙"
                           FontSize="60"
                           FontFamily="Segoe UI Emoji"
                           Foreground="#FF4D00"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
            </Border>

            <TextBlock Text="Панель администратора"
                       Foreground="#FF4D00"
                       FontSize="48"
                       FontWeight="Bold"
                       TextAlignment="Center"
                       Margin="0,0,0,20"/>

            <TextBlock Text="Добро пожаловать в систему управления"
                       Foreground="#CCCCCC"
                       FontSize="20"
                       TextAlignment="Center"
                       Margin="0,0,0,40"/>

            <Grid Margin="0,0,0,30">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Background="#000000"
                        CornerRadius="12"
                        BorderBrush="#FF4D00"
                        BorderThickness="2"
                        Padding="20"
                        Height="180">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="👥"
                                   FontSize="40"
                                   FontFamily="Segoe UI Emoji"
                                   Foreground="#FF4D00"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,10"/>
                        <TextBlock Text="Пользователи"
                                   Foreground="#FF4D00"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,8"/>
                        <TextBlock Text="Управление пользователями системы"
                                   Foreground="#AAAAAA"
                                   FontSize="12"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2"
                        Background="#000000"
                        CornerRadius="12"
                        BorderBrush="#FF4D00"
                        BorderThickness="2"
                        Padding="20"
                        Height="180">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="🍱"
                                   FontSize="40"
                                   FontFamily="Segoe UI Emoji"
                                   Foreground="#FF4D00"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,10"/>
                        <TextBlock Text="Меню"
                                   Foreground="#FF4D00"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,8"/>
                        <TextBlock Text="Управление позициями меню"
                                   Foreground="#AAAAAA"
                                   FontSize="12"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="4"
                        Background="#000000"
                        CornerRadius="12"
                        BorderBrush="#FF4D00"
                        BorderThickness="2"
                        Padding="20"
                        Height="180">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="➕"
                                   FontSize="40"
                                   FontFamily="Segoe UI Emoji"
                                   Foreground="#FF4D00"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,10"/>
                        <TextBlock Text="Создание"
                                   Foreground="#FF4D00"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,8"/>
                        <TextBlock Text="Создание новых позиций"
                                   Foreground="#AAAAAA"
                                   FontSize="12"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Background="#000000"
                    CornerRadius="10"
                    BorderBrush="#333333"
                    BorderThickness="1"
                    Padding="25"
                    Margin="0,20,0,0">
                <StackPanel>
                    <TextBlock FontSize="16"
                               FontWeight="Bold"
                               Margin="0,0,0,10">
                        <Run Text="💡" 
                             FontFamily="Segoe UI Emoji"
                             Foreground="White"/>
                        <Run Text=" Подсказка" 
                             Foreground="#FF4D00"/>
                    </TextBlock>
                    <TextBlock Text="Используйте боковую панель для навигации по разделам административной панели. Все функции управления доступны через меню слева."
                               Foreground="#CCCCCC"
                               FontSize="14"
                               TextWrapping="Wrap"
                               LineHeight="22"/>
                </StackPanel>
            </Border>
        </StackPanel>

        <Border Grid.Row="1"
                Background="#000000"
                BorderBrush="#FF4D00"
                BorderThickness="0,1,0,0"
                Padding="20">
            <TextBlock Text="Kaori Mau — Система управления рестораном"
                       Foreground="#666666"
                       FontSize="14"
                       HorizontalAlignment="Center"/>
        </Border>
    </Grid>
</UserControl>

