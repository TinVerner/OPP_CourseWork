<UserControl x:Class="ООП_Курсовой.Views.Pages.CreateCustomSetPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:support="clr-namespace:ООП_Курсовой.SupportClasses"
             Background="#111111">
    <UserControl.Resources>
        <support:NullableLongToBoolConverter x:Key="NullableLongToBoolConverter"/>
        <support:NullableLongToBoolMultiConverter x:Key="NullableLongToBoolMultiConverter"/>
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Соберите свой кастомный сет из готовых роллов"
                   Foreground="#FF4D00"
                   FontSize="28"
                   FontWeight="Bold"
                   Margin="0,0,0,10"/>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="3*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Margin="0,0,20,0">
                <Border Background="#000000"
                        CornerRadius="16"
                        BorderBrush="#FF4D00"
                        BorderThickness="1"
                        Height="380"
                        HorizontalAlignment="Center">
                    <Image Source="{Binding DisplayImageUrl}"
                           Stretch="Uniform"
                           Margin="16"/>
                </Border>

                <Button Content="Выбрать изображение"
                        Style="{StaticResource RoundedButton}"
                        Height="32"
                        Margin="0,10,0,0"
                        Visibility="{Binding AdminPanelVisibility}"
                        Command="{Binding BrowseImageCommand}"/>

                <TextBlock Text="Категория"
                           Foreground="#CCCCCC"
                           FontSize="14"
                           Margin="0,16,0,4"
                           Visibility="{Binding AdminPanelVisibility}"/>
                <Border Background="#000000"
                        CornerRadius="8"
                        BorderBrush="#333333"
                        BorderThickness="1"
                        Padding="8"
                        Visibility="{Binding AdminPanelVisibility}"
                        Margin="0,0,0,16">
                    <ScrollViewer MaxHeight="150"
                                  VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <ItemsControl ItemsSource="{Binding Categories}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <RadioButton Content="{Binding Name}"
                                                     GroupName="SetCategories"
                                                     Foreground="White"
                                                     Margin="0,2,0,2"
                                                     Command="{Binding DataContext.CategoryChangedCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                     CommandParameter="{Binding Id}">
                                            <RadioButton.IsChecked>
                                                <MultiBinding Converter="{StaticResource NullableLongToBoolMultiConverter}" Mode="OneWay">
                                                    <Binding Path="DataContext.SelectedCategoryId" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                                    <Binding Path="Id"/>
                                                </MultiBinding>
                                            </RadioButton.IsChecked>
                                        </RadioButton>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <TextBlock Text="Название вашего сета"
                           Foreground="#CCCCCC"
                           FontSize="14"
                           Margin="0,2,0,4"/>
                <TextBox Background="#000000"
                         Foreground="White"
                         BorderBrush="#FF4D00"
                         BorderThickness="1"
                         Padding="6"
                         FontSize="16"
                         MaxLength="50"
                         Text="{Binding SetName}"/>

                <TextBlock Text="Выбранные роллы"
                           Foreground="#CCCCCC"
                           FontSize="14"
                           Margin="0,5,0,4"/>
                <Border Background="#000000"
                        CornerRadius="8"
                        BorderBrush="#333333"
                        BorderThickness="1"
                        Padding="8"
                        Height="120">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <TextBlock Text="{Binding SelectedRollsText}"
                                   Foreground="#DDDDDD"
                                   TextWrapping="Wrap"/>
                    </ScrollViewer>
                </Border>

                <TextBlock Text="{Binding MacroSummaryText}"
                           Margin="0,10,0,0"
                           Foreground="#FF4D00"
                           FontSize="13"/>
            </StackPanel>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Выберите роллы (минимум 1)"
                           Foreground="#CCCCCC"
                           FontSize="14"
                           Margin="0,0,0,6"/>

                <Border Grid.Row="1"
                        Background="#000000"
                        CornerRadius="12"
                        BorderBrush="#FF4D00"
                        BorderThickness="1">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding RollOptions}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="8,4"
                                            Padding="10"
                                            Background="#111111"
                                            CornerRadius="8"
                                            BorderBrush="#333333"
                                            BorderThickness="1">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                          Foreground="White"
                                                          Margin="0,0,8,0"/>
                                                <TextBlock Text="{Binding Name}"
                                                           Foreground="White"
                                                           FontSize="16"
                                                           FontWeight="Bold"/>
                                                <TextBlock Text="{Binding Price, StringFormat='  ·  {0} руб.'}"
                                                           Foreground="#FF4D00"
                                                           FontSize="14"
                                                           Margin="6,0,0,0"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Description}"
                                                       Foreground="#BBBBBB"
                                                       FontSize="13"
                                                       Margin="24,4,0,0"
                                                       TextWrapping="Wrap"/>
                                            <TextBlock Foreground="#888888"
                                                       FontSize="12"
                                                       Margin="24,6,0,0">
                                                <TextBlock.Text>
                                                    <MultiBinding StringFormat="Б: {0:0.##} г · Ж: {1:0.##} г · У: {2:0.##} г · Ккал: {3:0.##}">
                                                        <Binding Path="ProteinG" TargetNullValue="0"/>
                                                        <Binding Path="FatG" TargetNullValue="0"/>
                                                        <Binding Path="CarbsG" TargetNullValue="0"/>
                                                        <Binding Path="CaloriesKcal" TargetNullValue="0"/>
                                                    </MultiBinding>
                                                </TextBlock.Text>
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Grid>

        <Grid Grid.Row="2" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Text="{Binding PriceText}"
                       Grid.Column="0"
                       VerticalAlignment="Center"
                       Foreground="#FFFFFF"
                       FontSize="16"
                       FontWeight="Bold"/>

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">

                <Button Content="Сбросить выбор"
                        Style="{StaticResource RoundedButton}"
                        Width="180"
                        Margin="0,0,10,0"
                        Command="{Binding ResetSelectionCommand}"/>

                <Button Content="Создать сет"
                        Style="{StaticResource RoundedButton}"
                        Width="200"
                        Margin="0,0,10,0"
                        Command="{Binding CreateSetOnlyCommand}"/>

                <Button Content="Создать и добавить в корзину"
                        Style="{StaticResource RoundedButton}"
                        Margin="0,0,10,0"
                        Width="240"
                        Command="{Binding CreateSetAndAddToCartCommand}"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>

