<UserControl x:Class="ООП_Курсовой.Views.Pages.HomePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#111111">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
            <Border Background="#1E1E1E"
                    CornerRadius="15"
                    Padding="40"
                    Margin="0,0,0,30"
                    BorderBrush="#FF4D00"
                    BorderThickness="2">
                <StackPanel>
                    <TextBlock Text="{Binding WelcomeMessage}"
                               Foreground="#FF4D00"
                               FontSize="48"
                               FontWeight="Bold"
                               TextAlignment="Center"
                               Margin="0,0,0,15"/>

                    <TextBlock Text="Добро пожаловать в Kaori Mau!"
                               Foreground="White"
                               FontSize="24"
                               TextAlignment="Center"
                               Margin="0,0,0,10"/>

                    <TextBlock Text="{Binding UserInfoText}"
                               Foreground="#CCCCCC"
                               FontSize="18"
                               TextAlignment="Center"
                               Margin="0,0,0,20"/>

                    <TextBlock Text="Японская кухня премиум-класса с доставкой на дом"
                               Foreground="#999999"
                               FontSize="16"
                               TextAlignment="Center"
                               FontStyle="Italic"/>
                </StackPanel>
            </Border>

            <TextBlock Text="Быстрые действия"
                       Foreground="#FF4D00"
                       FontSize="28"
                       FontWeight="Bold"
                       Margin="0,0,0,20"/>

            <UniformGrid Columns="3" Rows="2" Margin="0,0,0,30">
                <Border Style="{StaticResource CardBorder}"
                        Padding="25"
                        Margin="10"
                        MouseLeftButtonDown="MenuCard_MouseLeftButtonDown">
                    <StackPanel>
                        <TextBlock Text="🍣"
                                   FontSize="48"
                                   TextAlignment="Center"
                                   Margin="0,0,0,10"/>
                        <TextBlock Text="Меню"
                                   Foreground="#FF4D00"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   TextAlignment="Center"
                                   Margin="0,0,0,5"/>
                        <TextBlock Text="{Binding RollsCount, StringFormat='{}{0} роллов'}"
                                   Foreground="#CCCCCC"
                                   FontSize="14"
                                   TextAlignment="Center"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardBorder}"
                        Padding="25"
                        Margin="10"
                        MouseLeftButtonDown="SetsCard_MouseLeftButtonDown">
                    <StackPanel>
                        <TextBlock Text="🍱"
                                   FontSize="48"
                                   TextAlignment="Center"
                                   Margin="0,0,0,10"/>
                        <TextBlock Text="Сеты"
                                   Foreground="#FF4D00"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   TextAlignment="Center"
                                   Margin="0,0,0,5"/>
                        <TextBlock Text="{Binding SetsCount, StringFormat='{}{0} сетов'}"
                                   Foreground="#CCCCCC"
                                   FontSize="14"
                                   TextAlignment="Center"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardBorder}"
                        Padding="25"
                        Margin="10"
                        MouseLeftButtonDown="CartCard_MouseLeftButtonDown">
                    <StackPanel>
                        <TextBlock Text="🛒"
                                   FontSize="48"
                                   TextAlignment="Center"
                                   Margin="0,0,0,10"/>
                        <TextBlock Text="Корзина"
                                   Foreground="#FF4D00"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   TextAlignment="Center"
                                   Margin="0,0,0,5"/>
                        <TextBlock Text="{Binding CartItemsCount, StringFormat='{}{0} позиций'}"
                                   Foreground="#CCCCCC"
                                   FontSize="14"
                                   TextAlignment="Center"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardBorder}"
                        Padding="25"
                        Margin="10"
                        MouseLeftButtonDown="CustomRollsCard_MouseLeftButtonDown">
                    <StackPanel>
                        <TextBlock Text="✨"
                                   FontSize="48"
                                   TextAlignment="Center"
                                   Margin="0,0,0,10"/>
                        <TextBlock Text="Мои роллы"
                                   Foreground="#FF4D00"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   TextAlignment="Center"
                                   Margin="0,0,0,5"/>
                        <TextBlock Text="Создайте свой"
                                   Foreground="#CCCCCC"
                                   FontSize="14"
                                   TextAlignment="Center"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardBorder}"
                        Padding="25"
                        Margin="10"
                        MouseLeftButtonDown="CustomSetsCard_MouseLeftButtonDown">
                    <StackPanel>
                        <TextBlock Text="🎨"
                                   FontSize="48"
                                   TextAlignment="Center"
                                   Margin="0,0,0,10"/>
                        <TextBlock Text="Мои сеты"
                                   Foreground="#FF4D00"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   TextAlignment="Center"
                                   Margin="0,0,0,5"/>
                        <TextBlock Text="Персональные"
                                   Foreground="#CCCCCC"
                                   FontSize="14"
                                   TextAlignment="Center"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardBorder}"
                        Padding="25"
                        Margin="10"
                        MouseLeftButtonDown="ProfileCard_MouseLeftButtonDown">
                    <StackPanel>
                        <TextBlock Text="👤"
                                   FontSize="48"
                                   TextAlignment="Center"
                                   Margin="0,0,0,10"/>
                        <TextBlock Text="Профиль"
                                   Foreground="#FF4D00"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   TextAlignment="Center"
                                   Margin="0,0,0,5"/>
                        <TextBlock Text="Настройки"
                                   Foreground="#CCCCCC"
                                   FontSize="14"
                                   TextAlignment="Center"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <Border Background="#1E1E1E"
                    CornerRadius="15"
                    Padding="30"
                    BorderBrush="#FF4D00"
                    BorderThickness="2">
                <StackPanel>
                    <TextBlock Text="О нас"
                               Foreground="#FF4D00"
                               FontSize="24"
                               FontWeight="Bold"
                               Margin="0,0,0,15"/>

                    <TextBlock TextWrapping="Wrap"
                               Foreground="#CCCCCC"
                               FontSize="16"
                               LineHeight="24"
                               Margin="0,0,0,15">
                        <Run Text="Kaori Mau — это ресторан японской кухни, где каждый ролл создаётся с любовью и вниманием к деталям. Мы используем только свежие ингредиенты премиум-класса и традиционные рецепты с современными нотками."/>
                    </TextBlock>

                    <UniformGrid Columns="3" Margin="0,10,0,0">
                        <StackPanel Margin="0,0,20,0">
                            <TextBlock Text="⏰"
                                       FontSize="32"
                                       TextAlignment="Center"
                                       Margin="0,0,0,5"/>
                            <TextBlock Text="Время работы"
                                       Foreground="#FF4D00"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       TextAlignment="Center"
                                       Margin="0,0,0,5"/>
                            <TextBlock Text="10:00 - 23:00"
                                       Foreground="#CCCCCC"
                                       FontSize="14"
                                       TextAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Margin="0,0,20,0">
                            <TextBlock Text="🚚"
                                       FontSize="32"
                                       TextAlignment="Center"
                                       Margin="0,0,0,5"/>
                            <TextBlock Text="Доставка"
                                       Foreground="#FF4D00"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       TextAlignment="Center"
                                       Margin="0,0,0,5"/>
                            <TextBlock Text="30-60 минут"
                                       Foreground="#CCCCCC"
                                       FontSize="14"
                                       TextAlignment="Center"/>
                        </StackPanel>

                        <StackPanel>
                            <TextBlock Text="⭐"
                                       FontSize="32"
                                       TextAlignment="Center"
                                       Margin="0,0,0,5"/>
                            <TextBlock Text="Качество"
                                       Foreground="#FF4D00"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       TextAlignment="Center"
                                       Margin="0,0,0,5"/>
                            <TextBlock Text="Премиум"
                                       Foreground="#CCCCCC"
                                       FontSize="14"
                                       TextAlignment="Center"/>
                        </StackPanel>
                    </UniformGrid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>

