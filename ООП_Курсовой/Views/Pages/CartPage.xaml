<UserControl x:Class="ООП_Курсовой.Views.Pages.CartPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:support="clr-namespace:ООП_Курсовой.SupportClasses"
             Background="#111111">
    <UserControl.Resources>
        <support:CountToVisibilityConverter x:Key="CountToVisibilityConverter"/>
        <support:CountToVisibilityConverterInverse x:Key="CountToVisibilityConverterInverse"/>
        <support:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>
    </UserControl.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,20">
            <TextBlock Text="🛒"
                       Foreground="#FF4D00"
                       FontSize="36"
                       Margin="0,0,15,0"
                       VerticalAlignment="Center"/>
            <TextBlock Text="Корзина"
                       Foreground="#FF4D00"
                       FontSize="36"
                       FontWeight="Bold"
                       VerticalAlignment="Center"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid>
                <StackPanel Visibility="{Binding Items.Count, Converter={StaticResource CountToVisibilityConverter}}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Margin="0,100,0,0">
                    <TextBlock Text="🛒"
                               Foreground="#FF4D00"
                               FontSize="80"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,20"/>
                    <TextBlock Text="Ваша корзина пуста"
                               Foreground="White"
                               FontSize="24"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,10"/>
                    <TextBlock Text="Добавьте товары из меню, чтобы оформить заказ"
                               Foreground="#CCCCCC"
                               FontSize="16"
                               HorizontalAlignment="Center"/>
                </StackPanel>
                
                <ItemsControl ItemsSource="{Binding Items}"
                              Visibility="{Binding Items.Count, Converter={StaticResource CountToVisibilityConverterInverse}}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#000000"
                                    BorderBrush="#FF4D00"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Margin="0,0,0,15"
                                    Padding="0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0"
                                            Background="#111111"
                                            CornerRadius="10,0,0,10"
                                            Width="150"
                                            Height="150">
                                        <Grid>
                                            <Image Stretch="UniformToFill"
                                                   VerticalAlignment="Center"
                                                   HorizontalAlignment="Center"
                                                   Opacity="0.9"
                                                   Source="{Binding ImageUrl}">
                                                <Image.Style>
                                                    <Style TargetType="Image">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding ImageUrl}" Value="{x:Null}">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Image.Style>
                                            </Image>
                                            <TextBlock Text="Нет&#10;фото"
                                                       Foreground="#666666"
                                                       FontSize="14"
                                                       FontWeight="Bold"
                                                       TextAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       HorizontalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding ImageUrl}" Value="{x:Null}">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                    </Border>

                                    <StackPanel Grid.Column="1"
                                                VerticalAlignment="Center"
                                                Margin="20,0">
                                        <TextBlock Text="{Binding Name}"
                                                   Foreground="White"
                                                   FontSize="20"
                                                   FontWeight="Bold"
                                                   Margin="0,0,0,8"
                                                   TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding Description}"
                                                   Foreground="#AAAAAA"
                                                   FontSize="13"
                                                   FontStyle="Italic"
                                                   Margin="0,0,0,10"
                                                   TextWrapping="Wrap"
                                                   LineHeight="18"
                                                   MaxHeight="54"
                                                   Visibility="{Binding Description, Converter={StaticResource StringToVisibilityConverter}}"/>
                                        <TextBlock Text="{Binding Price, StringFormat='Цена за единицу: {}{0} руб.'}"
                                                   Foreground="#CCCCCC"
                                                   FontSize="14"
                                                   Margin="0,0,0,4"/>
                                        <TextBlock Text="{Binding Total, StringFormat='Итого: {}{0} руб.'}"
                                                   Foreground="#FF4D00"
                                                   FontSize="16"
                                                   FontWeight="Bold"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" 
                                                Orientation="Horizontal"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Margin="20,0">
                                        <Button Content="−"
                                                Width="40"
                                                Height="40"
                                                FontSize="24"
                                                FontWeight="Bold"
                                                Padding="0"
                                                Command="{Binding DataContext.DecreaseQuantityCommand, RelativeSource={RelativeSource AncestorType=UserControl, Mode=FindAncestor}}"
                                                CommandParameter="{Binding MenuItemId}"
                                                Style="{StaticResource RoundedButton}"/>
                                        <Border Background="#111111"
                                                BorderBrush="#FF4D00"
                                                BorderThickness="1"
                                                CornerRadius="5"
                                                Padding="15,0"
                                                Margin="10,0"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Quantity}"
                                                       Foreground="White"
                                                       FontSize="20"
                                                       FontWeight="Bold"
                                                       VerticalAlignment="Center"
                                                       HorizontalAlignment="Center"
                                                       MinWidth="40"
                                                       TextAlignment="Center"/>
                                        </Border>
                                        <Button Content="+"
                                                Width="40"
                                                Height="40"
                                                FontSize="20"
                                                FontWeight="Bold"
                                                Padding="0"
                                                Command="{Binding DataContext.IncreaseQuantityCommand, RelativeSource={RelativeSource AncestorType=UserControl, Mode=FindAncestor}}"
                                                CommandParameter="{Binding MenuItemId}"
                                                Style="{StaticResource RoundedButton}"/>
                                    </StackPanel>

                                    <TextBlock Grid.Column="3"
                                               Text="{Binding Total, StringFormat='{}{0} руб.'}"
                                               Foreground="#FF4D00"
                                               FontSize="22"
                                               FontWeight="Bold"
                                               VerticalAlignment="Center"
                                               Margin="30,0,30,0"
                                               MinWidth="120"
                                               TextAlignment="Right"/>

                                    <Button Grid.Column="4"
                                            Content="✕"
                                            Width="50"
                                            Height="50"
                                            FontSize="20"
                                            FontWeight="Bold"
                                            Margin="10,0,20,0"
                                            Command="{Binding DataContext.RemoveItemCommand, RelativeSource={RelativeSource AncestorType=UserControl, Mode=FindAncestor}}"
                                            CommandParameter="{Binding MenuItemId}"
                                            Style="{StaticResource RoundedButton}"
                                            ToolTip="Удалить из корзины"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </ScrollViewer>

        <Border Grid.Row="2"
                Background="#000000"
                BorderBrush="#FF4D00"
                BorderThickness="2"
                CornerRadius="10"
                Padding="25"
                Margin="0,20,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Итого к оплате:"
                               Foreground="#CCCCCC"
                               FontSize="18"
                               Margin="0,0,0,8"/>
                    <TextBlock Text="{Binding TotalPrice, StringFormat='{}{0} руб.'}"
                               Foreground="#FF4D00"
                               FontSize="32"
                               FontWeight="Bold"/>
                    <TextBlock Text="{Binding Items.Count, StringFormat='Товаров в корзине: {0}'}"
                               Foreground="#888888"
                               FontSize="14"
                               Margin="0,8,0,0"/>
                </StackPanel>

                <WrapPanel Grid.Column="1" 
                           Orientation="Horizontal"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           ItemHeight="40"
                           ItemWidth="220"
                           Margin="0,0,0,0">
                    <Button Content="Очистить корзину"
                            Width="200"
                            Height="40"
                            FontSize="16"
                            Margin="0,0,0,0"
                            Command="{Binding ClearCartCommand}"
                            Style="{StaticResource RoundedButton}"/>
                    <Button Content="Оформить заказ"
                            Width="220"
                            Margin="0,0,0,0"
                            Height="40"
                            FontSize="18"
                            FontWeight="Bold"
                            Command="{Binding CheckoutCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource RoundedButton}">
                                <Setter Property="Background" Value="#FF4D00"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Style.Triggers>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter Property="Background" Value="#666666"/>
                                        <Setter Property="Foreground" Value="#CCCCCC"/>
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#FF6D20"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </WrapPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>

