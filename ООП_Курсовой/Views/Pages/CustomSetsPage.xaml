<UserControl x:Class="ООП_Курсовой.Views.Pages.CustomSetsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:support="clr-namespace:ООП_Курсовой.SupportClasses"
             Background="#111111">
    <UserControl.Resources>
        <support:StringToBoolConverter x:Key="StringToBoolConverter"/>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="310"/>
        </Grid.ColumnDefinitions>

        <ScrollViewer Grid.Column="0" Margin="20"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Background="Transparent">
            <ItemsControl x:Name="RollsList" 
                          ItemsSource="{Binding FilteredSets}"
                          Background="Transparent">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Width="300"
                                Margin="12"
                                Padding="10"
                                CornerRadius="10"
                                Background="#000000"
                                BorderBrush="#FF4D00"
                                BorderThickness="1">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Row="0">
                                    <Image Source="{Binding ImageUrl}"
                                           Height="290"
                                           Stretch="UniformToFill"
                                           Margin="0,0,0,10"/>
                                    <TextBlock Text="{Binding Name}"
                                               Foreground="White"
                                               FontSize="18"
                                               FontWeight="Bold"
                                               TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding Price, StringFormat='Цена: {0} руб.'}"
                                               Foreground="#FFFFFF"
                                               FontSize="16"
                                               Margin="0,6,0,0"/>
                                    <TextBlock Text="{Binding IngredientsText}"
                                               Foreground="#CCCCCC"
                                               FontSize="12"
                                               Margin="0,6,0,10"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                                <StackPanel Grid.Row="1" Margin="0,10,0,0">
                                    <Button Content="Подробнее"
                                            Style="{StaticResource RoundedButton}"
                                            Height="32"
                                            Margin="0,0,0,6"
                                            Command="{Binding DataContext.DetailsCommand, RelativeSource={RelativeSource AncestorType=UserControl, Mode=FindAncestor}}"
                                            CommandParameter="{Binding}"/>
                                    <Button Content="В корзину"
                                            Style="{StaticResource RoundedButton}"
                                            Height="32"
                                            Margin="0,0,0,6"
                                            Command="{Binding DataContext.AddToCartCommand, RelativeSource={RelativeSource AncestorType=UserControl, Mode=FindAncestor}}"
                                            CommandParameter="{Binding Id}"/>
                                    <Button Content="Удалить"
                                            Style="{StaticResource RoundedButton}"
                                            Height="32"
                                            Command="{Binding DataContext.DeleteRollCommand, RelativeSource={RelativeSource AncestorType=UserControl, Mode=FindAncestor}}"
                                            CommandParameter="{Binding Id}"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Border Grid.Column="1"
                Background="#000000"
                Margin="10,20,10,20"
                CornerRadius="10"
                BorderBrush="#FF4D00"
                BorderThickness="1">
            <StackPanel Margin="10">
                <TextBlock Text="Поиск по сетам"
                           Foreground="#FF4D00"
                           FontSize="20"
                           FontWeight="Bold"
                           Margin="0,0,0,6"/>
                <TextBox x:Name="SearchTextBox"
                         Margin="0,0,0,10"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         Background="#111111"
                         Foreground="White"
                         BorderBrush="#FF4D00"
                         BorderThickness="1"
                         FontSize="18"
                         Padding="6"/>
                <TextBlock Text="Сортировка"
                           Foreground="#FF4D00"
                           FontSize="20"
                           FontWeight="Bold"
                           Margin="0,10,0,4"/>
                <StackPanel Margin="0,0,0,10">
                    <RadioButton Content="Без сортировки"
                                 GroupName="SortGroup"
                                 IsChecked="{Binding SortMode, Converter={StaticResource StringToBoolConverter}, ConverterParameter='none', Mode=TwoWay}"
                                 Foreground="White"/>
                    <RadioButton Content="Цена по возрастанию"
                                 GroupName="SortGroup"
                                 IsChecked="{Binding SortMode, Converter={StaticResource StringToBoolConverter}, ConverterParameter='priceAsc', Mode=TwoWay}"
                                 Foreground="White"/>
                    <RadioButton Content="Цена по убыванию"
                                 GroupName="SortGroup"
                                 IsChecked="{Binding SortMode, Converter={StaticResource StringToBoolConverter}, ConverterParameter='priceDesc', Mode=TwoWay}"
                                 Foreground="White"/>
                </StackPanel>
                <Button Content="Сбросить фильтры"
                        Margin="0,10,0,0"
                        FontSize="18"
                        Style="{StaticResource RoundedButton}"
                        Command="{Binding ResetFiltersCommand}"/>
                <Button Content="Создать свой сет"
                        Margin="0,10,0,0"
                        FontSize="18"
                        Style="{StaticResource RoundedButton}"
                        Command="{Binding CreateSetCommand}"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
