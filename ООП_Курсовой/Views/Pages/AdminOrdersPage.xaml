<UserControl x:Class="ООП_Курсовой.Views.Pages.AdminOrdersPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:tables="clr-namespace:ООП_Курсовой.Tables"
             mc:Ignorable="d"
             Background="#111111">
    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="250"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Margin="0,0,20,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Text="Управление заказами"
                       Foreground="#FF4D00"
                       FontSize="32"
                       FontWeight="Bold"
                       Margin="0,0,0,20"/>

            <ScrollViewer Grid.Row="1" 
                          VerticalScrollBarVisibility="Auto"
                          Margin="0,0,20,0">
                <ItemsControl ItemsSource="{Binding FilteredOrders}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#000000"
                                    BorderBrush="#FF4D00"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Margin="0,0,0,15"
                                    Padding="20">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding Id, StringFormat='Заказ №{0}'}"
                                                   Foreground="White"
                                                   FontSize="20"
                                                   FontWeight="Bold"
                                                   Margin="0,0,0,10"/>
                                        <TextBlock Text="{Binding StatusText, StringFormat='Статус: {0}'}"
                                                   Foreground="#FF4D00"
                                                   FontSize="16"
                                                   FontWeight="Bold"
                                                   Margin="0,0,0,8"/>
                                        <TextBlock Text="{Binding Description}"
                                                   Foreground="#CCCCCC"
                                                   FontSize="14"
                                                   TextWrapping="Wrap"
                                                   Margin="0,0,0,8"/>
                                        <TextBlock Text="{Binding CustomerName, StringFormat='Клиент: {0}'}"
                                                   Foreground="#AAAAAA"
                                                   FontSize="14"
                                                   Margin="0,0,0,4"/>
                                        <TextBlock Text="{Binding CustomerPhone, StringFormat='Телефон: {0}'}"
                                                   Foreground="#AAAAAA"
                                                   FontSize="14"
                                                   Margin="0,0,0,4"/>
                                        <TextBlock Text="{Binding DeliveryTypeText, StringFormat='Тип доставки: {0}'}"
                                                   Foreground="#AAAAAA"
                                                   FontSize="14"
                                                   Margin="0,0,0,8"/>
                                        <TextBlock Text="{Binding TotalPrice, StringFormat='Цена: {0} руб.'}"
                                                   Foreground="#FF4D00"
                                                   FontSize="18"
                                                   FontWeight="Bold"
                                                   Margin="0,8,0,0"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" 
                                                VerticalAlignment="Center"
                                                Margin="20,0,0,0">
                                        <Button Content="Изменить статус"
                                                Width="180"
                                                Height="40"
                                                FontSize="14"
                                                Command="{Binding DataContext.ChangeStatusCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource RoundedButton}"
                                                Margin="0,0,0,10"/>
                                        <Button Content="Подробнее"
                                                Width="180"
                                                Height="40"
                                                FontSize="14"
                                                Command="{Binding DataContext.ViewDetailsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding Id}"
                                                Style="{StaticResource RoundedButton}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <Border Grid.Column="1"
                Background="#000000"
                BorderBrush="#FF4D00"
                BorderThickness="1"
                CornerRadius="10"
                Padding="15">
            <StackPanel>
                <TextBlock Text="Фильтр по статусу"
                           Foreground="#FF4D00"
                           FontSize="18"
                           FontWeight="Bold"
                           Margin="0,0,0,15"/>
                
                <ListBox ItemsSource="{Binding StatusFilters}"
                         SelectedItem="{Binding SelectedFilter}"
                         Background="#111111"
                         BorderBrush="#333333"
                         BorderThickness="1">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding DisplayName}"
                                       Foreground="White"
                                       FontSize="14"
                                       Padding="8,4"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Margin" Value="0,2"/>
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#FF4D00"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#333333"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>

