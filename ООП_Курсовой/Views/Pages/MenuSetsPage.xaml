<UserControl x:Class="ООП_Курсовой.Views.Pages.MenuSetsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:support="clr-namespace:ООП_Курсовой.SupportClasses"
             Background="#111111">
    <UserControl.Resources>
        <support:StringToBoolConverter x:Key="StringToBoolConverter"/>
        <support:NullableLongToBoolConverter x:Key="NullableLongToBoolConverter"/>
        <support:NullableLongToBoolMultiConverter x:Key="NullableLongToBoolMultiConverter"/>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="310"/>
        </Grid.ColumnDefinitions>

        <ScrollViewer Grid.Column="0" Margin="20"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Background="Transparent">

            <ItemsControl x:Name="SetsList" 
                          ItemsSource="{Binding FilteredSets}"
                          Background="Transparent">

                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Width="300"
                                Margin="12"
                                Padding="10"
                                CornerRadius="10"
                                Background="#000000"
                                BorderBrush="#FF4D00"
                                BorderThickness="1">

                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0">
                                    <Image Source="{Binding ImageUrl}"
                                           Height="290"
                                           Stretch="UniformToFill"
                                           Margin="0,0,0,10"/>

                                    <TextBlock Text="{Binding Name}"
                                               Foreground="White"
                                               FontSize="18"
                                               FontWeight="Bold"
                                               TextWrapping="Wrap"/>

                                    <TextBlock Text="{Binding Price, StringFormat='Цена: {0} руб.'}"
                                               Foreground="#FFFFFF"
                                               FontSize="16"
                                               Margin="0,6,0,0"/>

                                    <TextBlock Text="{Binding IngredientsText}"
                                               Foreground="#CCCCCC"
                                               FontSize="12"
                                               Margin="0,6,0,10"
                                               TextWrapping="Wrap"/>
                                </StackPanel>

                                <StackPanel Grid.Row="1" Margin="0,10,0,0">
                                    <Button Content="Подробнее"
                                            Style="{StaticResource RoundedButton}"
                                            Height="32"
                                            Margin="0,0,0,6"
                                            Command="{Binding DataContext.DetailsCommand, RelativeSource={RelativeSource AncestorType=UserControl, Mode=FindAncestor}}"
                                            CommandParameter="{Binding}"/>

                                    <Button Content="В корзину"
                                            Style="{StaticResource RoundedButton}"
                                            Height="32"
                                            Margin="0,0,0,0"
                                            Command="{Binding DataContext.AddToCartCommand, RelativeSource={RelativeSource AncestorType=UserControl, Mode=FindAncestor}}"
                                            CommandParameter="{Binding Id}"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Border Grid.Column="1"
                Background="#000000"
                Margin="10,20,10,20"
                CornerRadius="10"
                BorderBrush="#FF4D00"
                BorderThickness="1">
            <StackPanel Margin="10">
                <TextBlock Text="Поиск по сетам"
                           Foreground="#FF4D00"
                           FontSize="20"
                           FontWeight="Bold"
                           Margin="0,0,0,6"/>

                <TextBox x:Name="SearchTextBox"
                         Margin="0,0,0,10"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         Background="#111111"
                         Foreground="White"
                         BorderBrush="#FF4D00"
                         BorderThickness="1"
                         FontSize="18"
                         Padding="6"/>

                <TextBlock Text="Фильтр по категориям"
                           Foreground="#FF4D00"
                           FontSize="20"
                           FontWeight="Bold"
                           Margin="0,0,0,10"/>

                <ScrollViewer Height="140"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <RadioButton Content="Все категории"
                                     GroupName="SetCategories"
                                     IsChecked="{Binding SelectedCategoryId, Converter={StaticResource NullableLongToBoolConverter}, ConverterParameter=-1, Mode=TwoWay}"
                                     Foreground="White"
                                     Margin="0,2,0,6"
                                     Command="{Binding CategoryFilterChangedCommand}"
                                     CommandParameter="{x:Null}"/>
                        <ItemsControl ItemsSource="{Binding Categories}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <RadioButton Content="{Binding Name}"
                                                 GroupName="SetCategories"
                                                 Foreground="White"
                                                 Margin="0,2,0,2"
                                                 Command="{Binding DataContext.CategoryFilterChangedCommand, RelativeSource={RelativeSource AncestorType=UserControl, Mode=FindAncestor}}"
                                                 CommandParameter="{Binding Id}">
                                        <RadioButton.IsChecked>
                                            <MultiBinding Converter="{StaticResource NullableLongToBoolMultiConverter}" Mode="OneWay">
                                                <Binding Path="DataContext.SelectedCategoryId" RelativeSource="{RelativeSource AncestorType=UserControl, Mode=FindAncestor}"/>
                                                <Binding Path="Id"/>
                                            </MultiBinding>
                                        </RadioButton.IsChecked>
                                    </RadioButton>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>

                <TextBlock Text="Сортировка"
                           Foreground="#FF4D00"
                           FontSize="20"
                           FontWeight="Bold"
                           Margin="0,15,0,10"/>

                <RadioButton Content="Без сортировки"
                             GroupName="Sort"
                             IsChecked="{Binding SortMode, Converter={StaticResource StringToBoolConverter}, ConverterParameter=none}"
                             Foreground="White"
                             Margin="0,5"/>
                <RadioButton Content="По цене (возр.)"
                             GroupName="Sort"
                             IsChecked="{Binding SortMode, Converter={StaticResource StringToBoolConverter}, ConverterParameter=priceAsc}"
                             Foreground="White"
                             Margin="0,5"/>
                <RadioButton Content="По цене (убыв.)"
                             GroupName="Sort"
                             IsChecked="{Binding SortMode, Converter={StaticResource StringToBoolConverter}, ConverterParameter=priceDesc}"
                             Foreground="White"
                             Margin="0,5"/>

                <Button Content="Сбросить фильтры"
                        Style="{StaticResource RoundedButton}"
                        Height="35"
                        Margin="0,15,0,0"
                        Command="{Binding ResetFiltersCommand}"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
