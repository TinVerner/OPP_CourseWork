<UserControl x:Class="ООП_Курсовой.Views.Pages.UsersAdminPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:support="clr-namespace:ООП_Курсовой.SupportClasses"
             Background="#111111">
    <UserControl.Resources>
        <support:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </UserControl.Resources>

    <Grid Margin="40">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,25">
            <TextBlock Text="Список пользователей"
                       Foreground="#FF4D00"
                       FontSize="32"
                       FontWeight="Bold"
                       Margin="0,0,0,8"/>
            <TextBlock Text="Управление пользователями системы"
                       Foreground="#CCCCCC"
                       FontSize="16"
                       Margin="0,0,0,20"/>
            
            <Border Background="#000000"
                    CornerRadius="8"
                    BorderBrush="#FF4D00"
                    BorderThickness="1"
                    Padding="12"
                    MaxWidth="500">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="🔍"
                               FontSize="18"
                               Foreground="#FF4D00"
                               VerticalAlignment="Center"
                               Margin="0,0,10,0"/>
                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             Background="Transparent"
                             Foreground="White"
                             BorderThickness="0"
                             FontSize="16"
                             VerticalContentAlignment="Center"
                             Padding="0"
                             Width="400">
                        <TextBox.Style>
                            <Style TargetType="TextBox">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="TextBox">
                                            <Border Background="{TemplateBinding Background}"
                                                    BorderThickness="0">
                                                <ScrollViewer x:Name="PART_ContentHost"
                                                              Margin="0"
                                                              VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </TextBox.Style>
                    </TextBox>
                </StackPanel>
            </Border>
        </StackPanel>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding Users}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,0,15"
                                Padding="25"
                                CornerRadius="12"
                                Background="#000000"
                                BorderBrush="#FF4D00"
                                BorderThickness="2"
                                HorizontalAlignment="Stretch">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="240"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                        <TextBlock Text="{Binding Lastname}"
                                                   Foreground="White"
                                                   FontSize="22"
                                                   FontWeight="Bold"
                                                   Margin="0,0,8,0"/>
                                        <TextBlock Text="{Binding Firstname}"
                                                   Foreground="White"
                                                   FontSize="20"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <StackPanel Margin="0,0,0,12">
                                        <TextBlock Text="{Binding Login, StringFormat='Логин: {0}'}"
                                                   Foreground="#CCCCCC"
                                                   FontSize="14"
                                                   Margin="0,0,0,6"/>
                                        <TextBlock Text="{Binding Email, StringFormat='Email: {0}'}"
                                                   Foreground="#CCCCCC"
                                                   FontSize="14"
                                                   Margin="0,0,0,6"/>
                                        <TextBlock Text="{Binding Phone, StringFormat='Телефон: {0}'}"
                                                   Foreground="#CCCCCC"
                                                   FontSize="14"
                                                   Margin="0,0,0,6"/>
                                        <TextBlock Text="{Binding Address, StringFormat='Адрес: {0}'}"
                                                   Foreground="#AAAAAA"
                                                   FontSize="13"
                                                   TextWrapping="Wrap"
                                                   Margin="0,0,0,0"/>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal">
                                        <Border Background="#1a1a1a"
                                                CornerRadius="6"
                                                Padding="8,4"
                                                Margin="0,0,10,0">
                                            <TextBlock Text="{Binding RoleName, StringFormat='Роль: {0}'}"
                                                       Foreground="#FF4D00"
                                                       FontSize="13"
                                                       FontWeight="SemiBold"/>
                                        </Border>
                                        <Border Background="#1a1a1a"
                                                CornerRadius="6"
                                                Padding="8,4"
                                                Visibility="{Binding IsBlocked, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <TextBlock Text="Заблокирован"
                                                       Foreground="#FF8888"
                                                       FontSize="13"
                                                       FontWeight="SemiBold"/>
                                        </Border>
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Grid.Column="2"
                                            VerticalAlignment="Center">
                                    <Button Content="Разблокировать"
                                            Width="240"
                                            Height="38"
                                            FontSize="14"
                                            Margin="0,0,0,10"
                                            Style="{StaticResource RoundedButton}"
                                            Visibility="{Binding IsBlocked, Converter={StaticResource BoolToVisibilityConverter}}"
                                            Command="{Binding DataContext.UnblockUserCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding Id}"/>

                                    <Button Content="Заблокировать"
                                            Width="240"
                                            Height="38"
                                            FontSize="14"
                                            Margin="0,0,0,10"
                                            Style="{StaticResource RoundedButton}"
                                            Visibility="{Binding IsNotBlocked, Converter={StaticResource BoolToVisibilityConverter}}"
                                            Command="{Binding DataContext.BlockUserCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding Id}"/>

                                    <Button Content="Редактировать"
                                            Width="240"
                                            Height="38"
                                            FontSize="14"
                                            Margin="0,0,0,10"
                                            Style="{StaticResource RoundedButton}"
                                            Command="{Binding DataContext.EditUserCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding Id}"/>

                                    <Button Content="Удалить"
                                            Width="240"
                                            Height="38"
                                            FontSize="14"
                                            Background="#AD0000"
                                            Foreground="White"
                                            BorderThickness="0"
                                            Style="{StaticResource RoundedButton}"
                                            Cursor="Hand"
                                            Command="{Binding DataContext.DeleteUserCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding Id}"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>

