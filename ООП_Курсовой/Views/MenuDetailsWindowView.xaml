<Window x:Class="ООП_Курсовой.Views.MenuDetailsWindowView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Подробная информация"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#111111"
        Width="820"
        Height="520"
        Icon="D:\Yes\Уник\3 курс\5 семестр\Курсовая\Приложение\ООП_Курсовой\src\icon2.png">

    <Border Margin="16"
            Background="#000000"
            CornerRadius="16"
            BorderBrush="#FF4D00"
            BorderThickness="1">
        <Grid Margin="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border CornerRadius="12"
                    BorderThickness="1"
                    Margin="0,0,16,0">
                <Image Source="{Binding Model.ImageUrl}"
                       Stretch="Uniform"
                       Margin="8"/>
            </Border>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="{Binding Model.Name}"
                           Foreground="White"
                           FontSize="22"
                           FontWeight="Bold"
                           Margin="0,0,0,6"
                           TextWrapping="Wrap"/>

                <TextBlock Grid.Row="1"
                           Text="{Binding Model.Price, StringFormat='Цена: {0} руб.'}"
                           Foreground="#FF4D00"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Margin="0,0,0,10"/>

                <Border Grid.Row="2"
                        Background="#111111"
                        CornerRadius="8"
                        Padding="8"
                        BorderBrush="#333333"
                        BorderThickness="1">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>

                            <TextBlock Text="Состав:"
                                       Foreground="#FF4D00"
                                       FontSize="14"
                                       FontWeight="Bold"
                                       Margin="0,0,0,6"/>

                            <TextBlock Text="{Binding Model.IngredientsText}"
                                       Foreground="#DDDDDD"
                                       FontSize="14"
                                       TextWrapping="Wrap"/>

                            <TextBlock Text="Пищевая ценность:"
                                       Foreground="#FF4D00"
                                       FontSize="14"
                                       FontWeight="Bold"
                                       Margin="0,16,0,6"/>

                            <StackPanel Margin="0,0,0,6">
                                <TextBlock Text="{Binding Model.CaloriesKcal, StringFormat='Калорийность: {0} кКал'}"
                                           Foreground="#DDDDDD"
                                           FontSize="14"
                                           Margin="0,0,0,2"/>

                                <TextBlock Text="{Binding Model.ProteinG, StringFormat='Белки: {0} г'}"
                                           Foreground="#DDDDDD"
                                           FontSize="14"
                                           Margin="0,0,0,2"/>

                                <TextBlock Text="{Binding Model.FatG, StringFormat='Жиры: {0} г'}"
                                           Foreground="#DDDDDD"
                                           FontSize="14"
                                           Margin="0,0,0,2"/>

                                <TextBlock Text="{Binding Model.CarbsG, StringFormat='Углеводы: {0} г'}"
                                           Foreground="#DDDDDD"
                                           FontSize="14"
                                           Margin="0,0,0,2"/>
                            </StackPanel>

                            <TextBlock Text="Описание:"
                                       Foreground="#FF4D00"
                                       FontSize="14"
                                       FontWeight="Bold"
                                       Margin="0,16,0,6"/>

                            <TextBlock Text="{Binding Model.Description}"
                                       Foreground="#DDDDDD"
                                       FontSize="14"
                                       TextWrapping="Wrap"/>

                        </StackPanel>
                    </ScrollViewer>
                </Border>



                <StackPanel Grid.Row="3"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="0,14,0,0">
                    <Button Content="Закрыть"
                            Width="140"
                            Margin="0,0,8,10"
                            Style="{StaticResource RoundedButton}"
                            Command="{Binding CloseCommand}"/>

                    <Button Content="В корзину"
                            Width="140"
                            Style="{StaticResource RoundedButton}"
                            Command="{Binding AddToCartCommand}"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>

