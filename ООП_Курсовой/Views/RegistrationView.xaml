<Window x:Class="ООП_Курсовой.Views.RegistrationView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:ООП_Курсовой.ViewModels"
        Icon="D:\Yes\Уник\3 курс\5 семестр\Курсовая\Приложение\ООП_Курсовой\src\icon2.png"
        mc:Ignorable="d"
        Title="Registration"
        Height="800" Width="400"
        WindowStartupLocation="CenterScreen"
        Background="#000000">

    <Grid>
        <Canvas>
            <Line X1="100" Y1="720" X2="405" Y2="35" Stroke="#FF4D00" StrokeThickness="1" />
            <Line X1="100" Y1="-10" X2="401" Y2="700" Stroke="#FF4D00" StrokeThickness="1" />
            <Line X1="400" Y1="00" X2="0" Y2="240" Stroke="#FF4D00" StrokeThickness="1" />
        </Canvas>

        <StackPanel VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Margin="20">

            <TextBlock Text="Регистрация"
                       Foreground="#FFFFFF"
                       FontSize="20"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,20" />

            <TextBlock Text="Введите логин:"
                       Foreground="#FFFFFF"
                       FontSize="14"
                       Margin="0,0,0,5"
                       HorizontalAlignment="Left" />
            <TextBox Style="{StaticResource RoundedTextBox}"
                     Text="{Binding Login, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Text="Введите имя:"
                       Foreground="#FFFFFF"
                       FontSize="14"
                       Margin="0,10,0,5"
                       HorizontalAlignment="Left" />
            <TextBox Style="{StaticResource RoundedTextBox}"
                     Text="{Binding FirstName, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Text="Введите фамилию:"
                       Foreground="#FFFFFF"
                       FontSize="14"
                       Margin="0,10,0,5"
                       HorizontalAlignment="Left" />
            <TextBox Style="{StaticResource RoundedTextBox}"
                     Text="{Binding LastName, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Text="Введите почту:"
                       Foreground="#FFFFFF"
                       FontSize="14"
                       Margin="0,10,0,5"
                       HorizontalAlignment="Left" />
            <TextBox Style="{StaticResource RoundedTextBox}"
                     Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Text="Введите номер телефона:"
                       Foreground="#FFFFFF"
                       FontSize="14"
                       Margin="0,10,0,5"
                       HorizontalAlignment="Left" />
            <TextBox Style="{StaticResource RoundedTextBox}"
                     Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Text="Введите адрес:"
                       Foreground="#FFFFFF"
                       FontSize="14"
                       Margin="0,10,0,5"
                       HorizontalAlignment="Left" />
            <TextBox Style="{StaticResource RoundedTextBox}"
                     Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Text="Введите пароль:"
                       Foreground="#FFFFFF"
                       FontSize="14"
                       Margin="0,10,0,5"
                       HorizontalAlignment="Left" />
            <PasswordBox x:Name="PasswordBox"
                         Style="{StaticResource RoundedPasswordBox}" />

            <TextBlock Text="Подтвердите пароль:"
                       Foreground="#FFFFFF"
                       FontSize="14"
                       Margin="0,10,0,5"
                       HorizontalAlignment="Left" />
            <PasswordBox x:Name="ConfirmPasswordBox"
                         Style="{StaticResource RoundedPasswordBox}" />

            <Button Content="Зарегистрироваться"
                    Style="{StaticResource RoundedButton}"
                    Cursor="Hand"
                    Margin="0,15,0,5"
                    Command="{Binding RegisterCommand}" />

            <TextBlock HorizontalAlignment="Center"
                       Foreground="#FF4D00"
                       FontSize="14"
                       Cursor="Hand">
                <Hyperlink Command="{Binding GoToLoginCommand}">
                    Уже есть аккаунт? Войти
                </Hyperlink>
            </TextBlock>
        </StackPanel>
    </Grid>
</Window>

