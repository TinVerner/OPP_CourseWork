<Window x:Class="ООП_Курсовой.Views.EditUserWindowView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Редактирование пользователя"
        Width="900"
        Height="800"
        Background="#111111"
        WindowStartupLocation="CenterOwner"
        Icon="D:\Yes\Уник\3 курс\5 семестр\Курсовая\Приложение\ООП_Курсовой\src\icon2.png">
    
    <Grid Margin="40">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Редактирование пользователя"
                   Foreground="#FF4D00"
                   FontSize="28"
                   FontWeight="Bold"
                   Margin="0,0,0,25"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Width="700" MaxWidth="700">
                
                <Border Background="#000000"
                        CornerRadius="12"
                        BorderBrush="#FF4D00"
                        BorderThickness="2"
                        Padding="25"
                        Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="Основная информация"
                                   Foreground="#FF4D00"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Margin="0,0,0,20"/>

                        <TextBlock Text="Логин"
                                   Foreground="#CCCCCC"
                                   FontSize="14"
                                   Margin="0,0,0,5"/>
                        <TextBox Style="{StaticResource RoundedTextBox}"
                                 FontSize="16"
                                 Margin="0,0,0,15"
                                 Text="{Binding Login, UpdateSourceTrigger=PropertyChanged}"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="15"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Имя"
                                           Foreground="#CCCCCC"
                                           FontSize="14"
                                           Margin="0,0,0,5"/>
                                <TextBox Style="{StaticResource RoundedTextBox}"
                                         FontSize="16"
                                         Margin="0,0,0,0"
                                         Text="{Binding FirstName, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Фамилия"
                                           Foreground="#CCCCCC"
                                           FontSize="14"
                                           Margin="0,0,0,5"/>
                                <TextBox Style="{StaticResource RoundedTextBox}"
                                         FontSize="16"
                                         Margin="0,0,0,0"
                                         Text="{Binding LastName, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Background="#000000"
                        CornerRadius="12"
                        BorderBrush="#FF4D00"
                        BorderThickness="2"
                        Padding="25"
                        Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="Контактная информация"
                                   Foreground="#FF4D00"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Margin="0,0,0,20"/>

                        <TextBlock Text="Email"
                                   Foreground="#CCCCCC"
                                   FontSize="14"
                                   Margin="0,0,0,5"/>
                        <TextBox Style="{StaticResource RoundedTextBox}"
                                 FontSize="16"
                                 Margin="0,0,0,15"
                                 Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Text="Телефон"
                                   Foreground="#CCCCCC"
                                   FontSize="14"
                                   Margin="0,0,0,5"/>
                        <TextBox Style="{StaticResource RoundedTextBox}"
                                 FontSize="16"
                                 Margin="0,0,0,15"
                                 Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Text="Адрес"
                                   Foreground="#CCCCCC"
                                   FontSize="14"
                                   Margin="0,0,0,5"/>
                        <TextBox Style="{StaticResource RoundedTextBox}"
                                 Height="80"
                                 FontSize="16"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 Margin="0,0,0,0"
                                 Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                </Border>

                <Border Background="#000000"
                        CornerRadius="12"
                        BorderBrush="#333333"
                        BorderThickness="1"
                        Padding="25"
                        Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="Информация об аккаунте"
                                   Foreground="#CCCCCC"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Margin="0,0,0,15"/>

                        <TextBlock Text="{Binding RoleText}"
                                   Foreground="#FF4D00"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,8"/>

                        <TextBlock Text="{Binding CreatedAtText}"
                                   Foreground="#AAAAAA"
                                   FontSize="14"
                                   Margin="0,0,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,20,0,0">
            <Button Content="Сохранить"
                    Width="180"
                    Height="50"
                    Margin="0,0,10,0"
                    FontSize="18"
                    FontWeight="SemiBold"
                    Style="{StaticResource RoundedButton}"
                    Command="{Binding SaveCommand}"/>
            <Button Content="Отмена"
                    Width="160"
                    Height="50"
                    FontSize="18"
                    Margin="15,0,0,0"
                    Style="{StaticResource RoundedButton}"
                    Background="#333333"
                    Foreground="White"
                    BorderBrush="#555555"
                    BorderThickness="1"
                    Command="{Binding CancelCommand}"/>
        </StackPanel>
    </Grid>
</Window>

