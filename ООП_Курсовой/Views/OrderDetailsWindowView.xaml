<Window x:Class="ООП_Курсовой.Views.OrderDetailsWindowView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:support="clr-namespace:ООП_Курсовой.SupportClasses"
        mc:Ignorable="d"
        Title="Детали заказа"
        Width="800"
        Height="700"
        Background="#111111"
        WindowStartupLocation="CenterScreen"
        Icon="D:\Yes\Уник\3 курс\5 семестр\Курсовая\Приложение\ООП_Курсовой\src\icon2.png">
    <Window.Resources>
        <support:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </Window.Resources>
    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="{Binding OrderNumber}"
                       Foreground="#FF4D00"
                       FontSize="28"
                       FontWeight="Bold"
                       Margin="0,0,0,15"/>
            <TextBlock Text="{Binding Status, StringFormat='Статус: {0}'}"
                       Foreground="#FF4D00"
                       FontSize="18"
                       FontWeight="Bold"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Background="#000000"
                        BorderBrush="#FF4D00"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="20"
                        Margin="0,0,0,15">
                    <StackPanel>
                        <TextBlock Text="Информация о заказе"
                                   Foreground="White"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Margin="0,0,0,15"/>
                        
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Дата создания:" Foreground="#CCCCCC" FontSize="14" Margin="0,0,0,10"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding CreatedAt}" Foreground="White" FontSize="14" Margin="0,0,0,10"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Время доставки:" Foreground="#CCCCCC" FontSize="14" Margin="0,0,0,10"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding DeliveryTime}" Foreground="White" FontSize="14" Margin="0,0,0,10"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Тип доставки:" Foreground="#CCCCCC" FontSize="14" Margin="0,0,0,10"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding DeliveryType}" Foreground="White" FontSize="14" Margin="0,0,0,10"/>

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Имя:" Foreground="#CCCCCC" FontSize="14" Margin="0,0,0,10"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding CustomerName}" Foreground="White" FontSize="14" Margin="0,0,0,10"/>

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Телефон:" Foreground="#CCCCCC" FontSize="14" Margin="0,0,0,10"/>
                            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding CustomerPhone}" Foreground="White" FontSize="14" Margin="0,0,0,10"/>

                            <TextBlock Grid.Row="5" Grid.Column="0" Text="Адрес:" Foreground="#CCCCCC" FontSize="14" Margin="0,0,0,10"/>
                            <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding CustomerAddress}" Foreground="White" FontSize="14" Margin="0,0,0,10" TextWrapping="Wrap"/>

                            <TextBlock Grid.Row="6" Grid.Column="0" Text="Комментарий:" Foreground="#CCCCCC" FontSize="14" Margin="0,0,0,10"/>
                            <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding Comment}" Foreground="White" FontSize="14" Margin="0,0,0,10" TextWrapping="Wrap"/>

                            <TextBlock Grid.Row="7" Grid.Column="0" Text="Дата доставки:" Foreground="#CCCCCC" FontSize="14"/>
                            <TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding DeliveredAt}" Foreground="White" FontSize="14"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Background="#000000"
                        BorderBrush="#FF4D00"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="20"
                        Margin="0,0,0,15">
                    <StackPanel>
                        <TextBlock Text="Состав заказа"
                                   Foreground="White"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Margin="0,0,0,15"/>
                        
                        <ItemsControl ItemsSource="{Binding Items}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#333333"
                                            BorderThickness="0,0,0,1"
                                            Padding="0,10,0,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding MenuItemName}"
                                                       Foreground="White"
                                                       FontSize="14"
                                                       VerticalAlignment="Center"/>

                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding Quantity, StringFormat='× {0}'}"
                                                       Foreground="#CCCCCC"
                                                       FontSize="14"
                                                       Margin="15,0"
                                                       VerticalAlignment="Center"/>

                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding Price}"
                                                       Foreground="#CCCCCC"
                                                       FontSize="14"
                                                       Margin="15,0"
                                                       VerticalAlignment="Center"/>

                                            <TextBlock Grid.Column="3"
                                                       Text="{Binding Total}"
                                                       Foreground="#FF4D00"
                                                       FontSize="14"
                                                       FontWeight="Bold"
                                                       VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2"
                Background="#000000"
                BorderBrush="#FF4D00"
                BorderThickness="1"
                CornerRadius="10"
                Padding="20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Итого к оплате:"
                               Foreground="#CCCCCC"
                               FontSize="16"
                               Margin="0,0,0,5"/>
                    <TextBlock Text="{Binding TotalPrice, StringFormat='{}{0} руб.'}"
                               Foreground="#FF4D00"
                               FontSize="24"
                               FontWeight="Bold"/>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Button Content="Отменить заказ"
                            Width="180"
                            Height="40"
                            FontSize="16"
                            Command="{Binding CancelOrderCommand}"
                            Style="{StaticResource RoundedButton}"
                            Margin="0,0,10,0"
                            Visibility="{Binding IsCancelable, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    <Button Content="Закрыть"
                            Width="150"
                            Height="40"
                            FontSize="16"
                            Command="{Binding CloseCommand}"
                            Style="{StaticResource RoundedButton}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>

