<Window x:Class="ООП_Курсовой.Views.CheckoutWindowView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:tables="clr-namespace:ООП_Курсовой.Tables"
        xmlns:support="clr-namespace:ООП_Курсовой.SupportClasses"
        mc:Ignorable="d"
        Title="Оформление заказа"
        Width="900"
        Height="800"
        Background="#111111"
        WindowStartupLocation="CenterScreen"
        Icon="D:\Yes\Уник\3 курс\5 семестр\Курсовая\Приложение\ООП_Курсовой\src\icon2.png"
        ResizeMode="NoResize">
    <Window.Resources>
        <support:EnumToBoolConverter x:Key="EnumToBoolConverter"/>
        <support:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        
        <Style x:Key="TimeComboBoxStyle" TargetType="ComboBox" BasedOn="{StaticResource DarkComboBox}">
            <Setter Property="Width" Value="200"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Border x:Name="MainBorder"
                                Background="#111111"
                                BorderBrush="#FF4D00"
                                BorderThickness="1"
                                CornerRadius="8">
                            <Grid>
                                <ContentPresenter x:Name="ContentSite"
                                                  IsHitTestVisible="False"
                                                  Content="{TemplateBinding SelectionBoxItem}"
                                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                  ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                                  Margin="10,3,30,3"
                                                  VerticalAlignment="Center"
                                                  HorizontalAlignment="Left"/>
                                <ToggleButton x:Name="ToggleButton"
                                              Focusable="False"
                                              IsChecked="{Binding Path=IsDropDownOpen,Mode=TwoWay,RelativeSource={RelativeSource TemplatedParent}}"
                                              ClickMode="Press"
                                              HorizontalAlignment="Right"
                                              Width="30">
                                    <ToggleButton.Style>
                                        <Style TargetType="ToggleButton">
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ToggleButton">
                                                        <Border Background="Transparent" 
                                                                BorderThickness="0"
                                                                Width="30"
                                                                Height="40">
                                                            <Path x:Name="Arrow"
                                                                  Fill="White"
                                                                  HorizontalAlignment="Right"
                                                                  VerticalAlignment="Center"
                                                                  Margin="0,0,10,0"
                                                                  Data="M 0 0 L 4 4 L 8 0 Z"/>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ToggleButton.Style>
                                </ToggleButton>
                                <Popup x:Name="Popup"
                                       Placement="Bottom"
                                       IsOpen="{TemplateBinding IsDropDownOpen}"
                                       AllowsTransparency="True"
                                       Focusable="False"
                                       PopupAnimation="Slide">
                                    <Grid x:Name="DropDown"
                                          SnapsToDevicePixels="True"
                                          MinWidth="{TemplateBinding ActualWidth}"
                                          MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                        <Border x:Name="DropDownBorder"
                                                Background="#111111"
                                                BorderThickness="1"
                                                BorderBrush="#FF4D00"
                                                CornerRadius="3">
                                            <ScrollViewer Margin="4,6,4,6"
                                                          SnapsToDevicePixels="True">
                                                <StackPanel IsItemsHost="True"
                                                            KeyboardNavigation.DirectionalNavigation="Contained"/>
                                            </ScrollViewer>
                                        </Border>
                                    </Grid>
                                </Popup>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ContentSite" Property="TextElement.Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="MainBorder" Property="BorderBrush" Value="#FFFFFF"/>
                                <Setter TargetName="MainBorder" Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>


        <Style TargetType="DatePickerTextBox">
            <Setter Property="Background" Value="#111111"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DatePickerTextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                VerticalAlignment="Stretch">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          VerticalContentAlignment="Center"
                                          VerticalAlignment="Center"
                                          Padding="10,0"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Calendar">
            <Setter Property="Background" Value="#111111"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#FF4D00"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style TargetType="CalendarDayButton">
            <Setter Property="Background" Value="#1E1E1E"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#333333"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CalendarDayButton">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#FF4D00"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#2A2A2A"/>
                                <Setter Property="BorderBrush" Value="#FF4D00"/>
                            </Trigger>
                            <Trigger Property="IsToday" Value="True">
                                <Setter Property="BorderBrush" Value="#FF4D00"/>
                                <Setter Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="CalendarItem">
            <Setter Property="Background" Value="#111111"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
    </Window.Resources>
    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,25">
            <TextBlock Text="📦"
                       Foreground="#FF4D00"
                       FontSize="32"
                       Margin="0,0,15,0"
                       VerticalAlignment="Center"/>
            <TextBlock Text="Оформление заказа"
                       Foreground="#FF4D00"
                       FontSize="28"
                       FontWeight="Bold"
                       VerticalAlignment="Center"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Background="#000000"
                        BorderBrush="#FF4D00"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="20"
                        Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="Контактная информация"
                                   Foreground="#FF4D00"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Margin="0,0,0,15"/>

                        <TextBlock Text="Имя *"
                                   Foreground="White"
                                   FontSize="14"
                                   Margin="0,0,0,5"/>
                        <TextBox Text="{Binding CustomerName, UpdateSourceTrigger=PropertyChanged}"
                                 Background="#111111"
                                 Foreground="White"
                                 BorderBrush="#FF4D00"
                                 BorderThickness="1"
                                 FontSize="16"
                                 Padding="10"
                                 Margin="0,0,0,15"/>

                        <TextBlock Text="Телефон *"
                                   Foreground="White"
                                   FontSize="14"
                                   Margin="0,0,0,5"/>
                        <TextBox Text="{Binding CustomerPhone, UpdateSourceTrigger=PropertyChanged}"
                                 Background="#111111"
                                 Foreground="White"
                                 BorderBrush="#FF4D00"
                                 BorderThickness="1"
                                 FontSize="16"
                                 Padding="10"
                                 Margin="0,0,0,15"/>
                    </StackPanel>
                </Border>

                <Border Background="#000000"
                        BorderBrush="#FF4D00"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="20"
                        Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="Способ доставки"
                                   Foreground="#FF4D00"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Margin="0,0,0,15"/>

                        <RadioButton Content="Самовывоз"
                                     GroupName="DeliveryType"
                                     IsChecked="{Binding DeliveryType, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=pickup, Mode=TwoWay}"
                                     Foreground="White"
                                     FontSize="16"
                                     Margin="0,0,0,10"
                                     Checked="DeliveryType_Checked"/>

                        <RadioButton Content="Доставка курьером"
                                     GroupName="DeliveryType"
                                     IsChecked="{Binding DeliveryType, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=courier, Mode=TwoWay}"
                                     Foreground="White"
                                     FontSize="16"
                                     Margin="0,0,0,15"
                                     Checked="DeliveryType_Checked"/>

                        <TextBlock Text="Желаемое время *"
                                   Foreground="White"
                                   FontSize="14"
                                   Margin="0,10,0,5"/>
                        <Grid Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="200"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0"
                                    Background="#111111"
                                    BorderBrush="#FF4D00"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Height="40"
                                    Width="200"
                                    VerticalAlignment="Center">
                                <DatePicker SelectedDate="{Binding DeliveryDate, UpdateSourceTrigger=PropertyChanged}"
                                           Style="{StaticResource DarkDatePicker}"
                                           DisplayDateStart="{Binding MinDeliveryDate, Mode=OneWay}"
                                           DisplayDateEnd="{Binding MaxDeliveryDate, Mode=OneWay}"
                                           VerticalAlignment="Stretch"
                                           VerticalContentAlignment="Center"
                                           Background="Transparent"
                                           BorderThickness="0"
                                           Width="200"
                                           Height="40"/>
                            </Border>

                            <ComboBox Grid.Column="2"
                                     SelectedItem="{Binding SelectedDeliveryTime, UpdateSourceTrigger=PropertyChanged}"
                                     ItemsSource="{Binding AvailableDeliveryTimes}"
                                     Style="{StaticResource TimeComboBoxStyle}"
                                     VerticalContentAlignment="Center">
                                <ComboBox.ItemContainerStyle>
                                    <Style TargetType="ComboBoxItem" BasedOn="{StaticResource DarkComboBoxItem}"/>
                                </ComboBox.ItemContainerStyle>
                            </ComboBox>
                        </Grid>

                        <StackPanel Visibility="{Binding IsDeliveryAddressVisible, Converter={StaticResource BoolToVisibilityConverter}}"
                                    Margin="0,0,0,0">
                            <TextBlock Text="Адрес доставки *"
                                       Foreground="White"
                                       FontSize="14"
                                       Margin="0,10,0,5"/>
                            <TextBox Text="{Binding CustomerAddress, UpdateSourceTrigger=PropertyChanged}"
                                     Background="#111111"
                                     Foreground="White"
                                     BorderBrush="#FF4D00"
                                     BorderThickness="1"
                                     FontSize="16"
                                     Padding="10"
                                     TextWrapping="Wrap"
                                     AcceptsReturn="True"
                                     MinHeight="60"
                                     VerticalScrollBarVisibility="Auto"
                                     Margin="0,0,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Background="#000000"
                        BorderBrush="#FF4D00"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="20"
                        Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="Дополнительная информация"
                                   Foreground="#FF4D00"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Margin="0,0,0,15"/>

                        <TextBlock Text="Комментарий к заказу"
                                   Foreground="White"
                                   FontSize="14"
                                   Margin="0,0,0,5"/>
                        <TextBox Text="{Binding Comment, UpdateSourceTrigger=PropertyChanged}"
                                 Background="#111111"
                                 Foreground="White"
                                 BorderBrush="#FF4D00"
                                 BorderThickness="1"
                                 FontSize="16"
                                 Padding="10"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 MinHeight="80"
                                 VerticalScrollBarVisibility="Auto"
                                 Margin="0,0,0,0"/>
                    </StackPanel>
                </Border>

                <Border Background="#000000"
                        BorderBrush="#FF4D00"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="20"
                        Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="Состав заказа"
                                   Foreground="#FF4D00"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Margin="0,0,0,15"/>

                        <ItemsControl ItemsSource="{Binding Items}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#111111"
                                            BorderBrush="#333333"
                                            BorderThickness="1"
                                            CornerRadius="5"
                                            Padding="10"
                                            Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding Name}"
                                                       Foreground="White"
                                                       FontSize="14"
                                                       VerticalAlignment="Center"/>

                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding Quantity, StringFormat='× {0}'}"
                                                       Foreground="#CCCCCC"
                                                       FontSize="14"
                                                       Margin="15,0"
                                                       VerticalAlignment="Center"/>

                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding Total, StringFormat='{}{0} руб.'}"
                                                       Foreground="#FF4D00"
                                                       FontSize="14"
                                                       FontWeight="Bold"
                                                       VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2"
                Background="#000000"
                BorderBrush="#FF4D00"
                BorderThickness="2"
                CornerRadius="10"
                Padding="25"
                Margin="0,20,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Итого к оплате:"
                               Foreground="#CCCCCC"
                               FontSize="18"
                               Margin="0,0,0,5"/>
                    <TextBlock Text="{Binding TotalPrice, StringFormat='{}{0} руб.'}"
                               Foreground="#FF4D00"
                               FontSize="28"
                               FontWeight="Bold"/>
                </StackPanel>

                <StackPanel Grid.Column="1" 
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Button Content="Отмена"
                            Width="150"
                            Height="45"
                            FontSize="16"
                            Margin="0,0,15,0"
                            Command="{Binding CancelCommand}"
                            Style="{StaticResource RoundedButton}"/>
                    <Button Content="Оформить заказ"
                            Width="200"
                            Margin="0,0,15,0"
                            Height="45"
                            FontSize="18"
                            FontWeight="Bold"
                            Command="{Binding SubmitOrderCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource RoundedButton}">
                                <Setter Property="Background" Value="#FF4D00"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Style.Triggers>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter Property="Background" Value="#666666"/>
                                        <Setter Property="Foreground" Value="#CCCCCC"/>
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#FF6D20"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>

