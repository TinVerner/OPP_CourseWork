<Window x:Class="ООП_Курсовой.Views.LoginView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Login"
        Height="400"
        Width="350"
        WindowStartupLocation="CenterScreen"
        Icon="D:\Yes\Уник\3 курс\5 семестр\Курсовая\Приложение\ООП_Курсовой\src\icon2.png"
        Background="#000000">

    <Grid>
        <Canvas>
            <Line X1="-10" Y1="300" X2="405" Y2="35" Stroke="#FF4D00" StrokeThickness="1" />
            <Line X1="100" Y1="-10" X2="350" Y2="400" Stroke="#FF4D00" StrokeThickness="1" />
            <Line X1="300" Y1="400" X2="0" Y2="140" Stroke="#FF4D00" StrokeThickness="1" />
        </Canvas>

        <StackPanel VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Margin="20">

            <TextBlock HorizontalAlignment="Center"
                       Foreground="#FFFFFF"
                       FontSize="20"
                       FontWeight="Bold"
                       Margin="0,0,0,20"
                       Text="Авторизация" />

            <TextBlock Text="Введите логин:"
                       Foreground="#FFFFFF"
                       FontSize="14"
                       Margin="0,0,0,5"
                       HorizontalAlignment="Left" />

            <TextBox Style="{StaticResource RoundedTextBox}"
                     Text="{Binding Login, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Text="Введите пароль:"
                       Foreground="#FFFFFF"
                       FontSize="14"
                       Margin="0,10,0,5"
                       HorizontalAlignment="Left" />

            <PasswordBox x:Name="PasswordBox"
                         Style="{StaticResource RoundedPasswordBox}"
                         KeyDown="PasswordBox_KeyDown" />

            <Button Content="Войти"
                    Cursor="Hand"
                    Style="{StaticResource RoundedButton}"
                    Margin="0,10,0,0"
                    Command="{Binding LoginCommand}" />

            <TextBlock HorizontalAlignment="Center"
                       Foreground="#FFFFFF"
                       FontSize="14"
                       Margin="0,10,0,0">
                <Hyperlink Command="{Binding GoToRegistrationCommand}">
                    Нет аккаунта? Регистрация
                </Hyperlink>
            </TextBlock>
        </StackPanel>
    </Grid>
</Window>

