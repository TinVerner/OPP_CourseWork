<Window x:Class="ООП_Курсовой.Views.EditMenuItemWindowView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:support="clr-namespace:ООП_Курсовой.SupportClasses"
        Title="Редактировать позицию меню"
        Width="1400"
        Height="900"
        WindowStartupLocation="CenterOwner"
        Background="#111111"
        ResizeMode="NoResize">
    <Window.Resources>
        <support:NullableLongToBoolConverter x:Key="NullableLongToBoolConverter"/>
        <support:NullableLongToBoolMultiConverter x:Key="NullableLongToBoolMultiConverter"/>
        <support:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </Window.Resources>

    <Border Background="#000000"
            CornerRadius="15"
            BorderBrush="#FF4D00"
            BorderThickness="2"
            Margin="20">
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      Margin="20">
            <StackPanel>
                <TextBlock Text="Редактирование позиции меню"
                           Foreground="#FF4D00"
                           FontSize="28"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,10"/>

                <TextBlock Text="{Binding ItemTypeDisplay}"
                           Foreground="#CCCCCC"
                           FontSize="18"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,25"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="350"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <Border Background="#111111"
                                CornerRadius="10"
                                BorderBrush="#333333"
                                BorderThickness="1"
                                Height="300"
                                Margin="0,0,0,15">
                            <Image Source="{Binding DisplayImageUrl}"
                                   Stretch="Uniform"
                                   Margin="10"/>
                        </Border>

                        <Button Content="Выбрать изображение"
                                Style="{StaticResource RoundedButton}"
                                Height="40"
                                FontSize="16"
                                Command="{Binding BrowseImageCommand}"
                                Margin="0,0,0,20"/>

                        <TextBlock Text="Название"
                                   Foreground="#CCCCCC"
                                   FontSize="14"
                                   Margin="0,0,0,5"/>
                        <TextBox Style="{StaticResource RoundedTextBox}"
                                 FontSize="16"
                                 Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,0,15"/>

                        <TextBlock Text="Описание"
                                   Foreground="#CCCCCC"
                                   FontSize="14"
                                   Margin="0,0,0,5"/>
                        <TextBox Style="{StaticResource RoundedTextBox}"
                                 Height="80"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 FontSize="16"
                                 Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,0,15"/>

                        <TextBlock Text="Цена (руб.)"
                                   Foreground="#CCCCCC"
                                   FontSize="14"
                                   Margin="0,0,0,5"/>
                        <TextBox Style="{StaticResource RoundedTextBox}"
                                 FontSize="16"
                                 Text="{Binding PriceText, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,0,15"/>

                        <TextBlock Text="БЖУ и калории"
                                   Foreground="#CCCCCC"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,10"/>

                        <Grid Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Белки (г)"
                                           Foreground="#CCCCCC"
                                           FontSize="14"
                                           Margin="0,0,0,5"/>
                                <Border Background="#000000"
                                        BorderBrush="#FF4D00"
                                        BorderThickness="2"
                                        CornerRadius="8"
                                        Height="35">
                                    <TextBox Background="Transparent"
                                             Foreground="#FFFFFF"
                                             BorderThickness="0"
                                             FontSize="16"
                                             Padding="6"
                                             VerticalContentAlignment="Center"
                                             Text="{Binding ProteinText, UpdateSourceTrigger=PropertyChanged}"/>
                                </Border>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Жиры (г)"
                                           Foreground="#CCCCCC"
                                           FontSize="14"
                                           Margin="0,0,0,5"/>
                                <Border Background="#000000"
                                        BorderBrush="#FF4D00"
                                        BorderThickness="2"
                                        CornerRadius="8"
                                        Height="35">
                                    <TextBox Background="Transparent"
                                             Foreground="#FFFFFF"
                                             BorderThickness="0"
                                             FontSize="16"
                                             Padding="6"
                                             VerticalContentAlignment="Center"
                                             Text="{Binding FatText, UpdateSourceTrigger=PropertyChanged}"/>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Углеводы (г)"
                                           Foreground="#CCCCCC"
                                           FontSize="14"
                                           Margin="0,0,0,5"/>
                                <Border Background="#000000"
                                        BorderBrush="#FF4D00"
                                        BorderThickness="2"
                                        CornerRadius="8"
                                        Height="35">
                                    <TextBox Background="Transparent"
                                             Foreground="#FFFFFF"
                                             BorderThickness="0"
                                             FontSize="16"
                                             Padding="6"
                                             VerticalContentAlignment="Center"
                                             Text="{Binding CarbsText, UpdateSourceTrigger=PropertyChanged}"/>
                                </Border>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Калории (ккал)"
                                           Foreground="#CCCCCC"
                                           FontSize="14"
                                           Margin="0,0,0,5"/>
                                <Border Background="#000000"
                                        BorderBrush="#FF4D00"
                                        BorderThickness="2"
                                        CornerRadius="8"
                                        Height="35">
                                    <TextBox Background="Transparent"
                                             Foreground="#FFFFFF"
                                             BorderThickness="0"
                                             FontSize="16"
                                             Padding="6"
                                             VerticalContentAlignment="Center"
                                             Text="{Binding CaloriesText, UpdateSourceTrigger=PropertyChanged}"/>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <Border Background="#111111"
                                CornerRadius="10"
                                BorderBrush="#333333"
                                BorderThickness="1"
                                Padding="15"
                                Margin="0,20,0,0"
                                Visibility="{Binding IsSet, Converter={StaticResource BoolToVisibilityConverter}}">
                            <StackPanel>
                                <TextBlock Text="Категория"
                                           Foreground="#FF4D00"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,10"
                                           Visibility="{Binding IsAdminItem, Converter={StaticResource BoolToVisibilityConverter}}"/>

                                <ScrollViewer MaxHeight="150"
                                              VerticalScrollBarVisibility="Auto"
                                              Visibility="{Binding IsAdminItem, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <StackPanel>
                                        <RadioButton Content="Без категории"
                                                     GroupName="SetCategories"
                                                     IsChecked="{Binding SelectedCategoryId, Converter={StaticResource NullableLongToBoolConverter}, ConverterParameter=-1, Mode=TwoWay}"
                                                     Foreground="White"
                                                     Margin="0,2,0,6"
                                                     Command="{Binding CategoryChangedCommand}"
                                                     CommandParameter="{x:Null}"/>
                                        <ItemsControl ItemsSource="{Binding Categories}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <RadioButton Content="{Binding Name}"
                                                                 GroupName="SetCategories"
                                                                 Foreground="White"
                                                                 Margin="0,2,0,2"
                                                                 Command="{Binding DataContext.CategoryChangedCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                 CommandParameter="{Binding Id}">
                                                        <RadioButton.IsChecked>
                                                            <MultiBinding Converter="{StaticResource NullableLongToBoolMultiConverter}" Mode="OneWay">
                                                                <Binding Path="DataContext.SelectedCategoryId" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                                                <Binding Path="Id"/>
                                                            </MultiBinding>
                                                        </RadioButton.IsChecked>
                                                    </RadioButton>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </ScrollViewer>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Ингредиенты"
                                   Foreground="#CCCCCC"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,10"
                                   Visibility="{Binding IsRoll, Converter={StaticResource BoolToVisibilityConverter}}"/>

                        <Border Background="#111111"
                                CornerRadius="10"
                                BorderBrush="#333333"
                                BorderThickness="1"
                                Padding="15"
                                Visibility="{Binding IsRoll, Converter={StaticResource BoolToVisibilityConverter}}">
                            <ScrollViewer MaxHeight="500"
                                          VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding IngredientOptions}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox Content="{Binding Name}"
                                                      IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                      Foreground="White"
                                                      Margin="0,4,0,4"
                                                      FontSize="16"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>

                        <TextBlock Text="Состав сета (роллы)"
                                   Foreground="#CCCCCC"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Margin="0,20,0,10"
                                   Visibility="{Binding IsSet, Converter={StaticResource BoolToVisibilityConverter}}"/>

                        <Border Background="#111111"
                                CornerRadius="10"
                                BorderBrush="#333333"
                                BorderThickness="1"
                                Padding="15"
                                Visibility="{Binding IsSet, Converter={StaticResource BoolToVisibilityConverter}}">
                            <ScrollViewer MaxHeight="500"
                                          VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding RollOptions}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="0,4,0,4"
                                                    Padding="10"
                                                    Background="#1E1E1E"
                                                    CornerRadius="8"
                                                    BorderBrush="#333333"
                                                    BorderThickness="1">
                                                <StackPanel Orientation="Horizontal">
                                                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                              Foreground="White"
                                                              Margin="0,0,10,0"
                                                              VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding Name}"
                                                               Foreground="White"
                                                               FontSize="16"
                                                               VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>
                    </StackPanel>
                </Grid>

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            Margin="0,30,0,0">
                    <Button Content="Сохранить"
                            Width="180"
                            Height="45"
                            Margin="0,0,10,0"
                            FontSize="18"
                            FontWeight="SemiBold"
                            Style="{StaticResource RoundedButton}"
                            Command="{Binding SaveCommand}"/>
                    <Button Content="Отмена"
                            Width="140"
                            Height="45"
                            FontSize="18"
                            FontWeight="SemiBold"
                            Margin="20,0,0,0"
                            Style="{StaticResource RoundedButton}"
                            Background="#444444"
                            Foreground="White"
                            Command="{Binding CancelCommand}"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Border>
</Window>

